{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "dotnet publish miTutoria.Web/miTutoria.Web.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "cd out && dotnet miTutoria.Web.dll --urls http://0.0.0.0:$PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
