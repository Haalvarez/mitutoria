@page "/Classroom/{studentId:int}"
@model miTutoria.Web.Pages.Classroom.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aula de " + Model.StudentName;
}

<main class="page-main">
    <div class="dashboard-header">
        <h1>Aula de @Model.StudentName</h1>
        <div class="dashboard-nav-links">
            <a href="/Dashboard">← Volver</a>
            <form method="post" asp-page-handler="Compact" style="display:inline;"
                  onsubmit="return confirm('¿Compactar el historial? Claude va a resumir la sesión y borrar los mensajes.')">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <button type="submit" class="btn-secondary">Compactar</button>
            </form>
            <form method="post" asp-page-handler="NewSession" style="display:inline;"
                  onsubmit="return confirm('¿Borrar todo? Se eliminan mensajes, material y resumen.')">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <button type="submit" class="btn-secondary">Nueva sesión</button>
            </form>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @* — Material — *@
    <section class="material-section">
        <details @(string.IsNullOrEmpty(Model.Material) ? "" : "open")>
            <summary class="material-summary">
                @(string.IsNullOrEmpty(Model.Material) ? "＋ Material de trabajo" : "📄 Material cargado — " + Model.Material.Length + " caracteres")
            </summary>
            <form method="post" asp-page-handler="SaveMaterial" class="material-form" enctype="multipart/form-data">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="form-field">
                    <label>Subir PDF (máx. 5 MB)</label>
                    <input type="file" name="PdfFile" accept="application/pdf" />
                </div>
                <div class="form-field">
                    <label>O pegá el texto</label>
                    <textarea name="Material" rows="4" placeholder="Pegá acá el enunciado o fotocopia...">@Model.Material</textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-main" style="font-size:0.85rem; padding:0.5rem 1.2rem;">Guardar material</button>
                    @if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <button type="submit" name="ClearMaterial" value="true" class="btn-secondary">Borrar</button>
                    }
                </div>
            </form>
        </details>
    </section>

    @* — Prompt personalizado — *@
    <section class="material-section">
        <details>
            <summary class="material-summary">
                @(string.IsNullOrEmpty(Model.CustomPrompt) ? "⚙️ Configurar tutor" : "⚙️ Tutor configurado")
            </summary>
            <form method="post" asp-page-handler="SavePrompt" class="material-form">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="form-field">
                    <label>Instrucciones adicionales para el tutor</label>
                    <textarea name="CustomPrompt" rows="4"
                        placeholder="Ej: Enfocate en matemáticas de 3° secundaria. Si pregunta sobre historia, decile que no es tu materia hoy.">@Model.CustomPrompt</textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-main" style="font-size:0.85rem; padding:0.5rem 1.2rem;">Guardar</button>
                </div>
            </form>
        </details>
    </section>

    @* — Resumen de sesión anterior — *@
    @if (!string.IsNullOrEmpty(Model.CompactSummary))
    {
        <div class="compact-summary">
            <span class="compact-summary__label">📝 Resumen de sesión anterior</span>
            <p>@Model.CompactSummary</p>
        </div>
    }

    @* — Chat — *@
    <section class="chat-history" id="chat-history">
        @if (Model.Messages.Count == 0)
        {
            <p class="empty-state">Todavía no hay mensajes en este aula.</p>
        }
        else
        {
            @foreach (var msg in Model.Messages)
            {
                <div class="chat-bubble chat-bubble--@msg.Role.ToString().ToLower()">
                    <span class="chat-bubble__role">@(msg.Role == miTutoria.Web.Data.Entities.Academic.MessageRole.User ? Model.StudentName : "Tutor")</span>
                    <p>@msg.Content</p>
                </div>
            }
        }
    </section>

    <form method="post" class="chat-form">
        <input type="hidden" name="StudentId" value="@Model.StudentId" />
        <div class="chat-input-row">
            <textarea name="Content" id="chat-input" rows="2" placeholder="Escribí tu pregunta..."></textarea>
            <button type="submit" class="btn-main">Enviar</button>
        </div>
    </form>
</main>

<script>
    const history = document.getElementById('chat-history');
    if (history) history.scrollTop = history.scrollHeight;

    document.getElementById('chat-input')?.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') this.closest('form').submit();
    });
</script>
