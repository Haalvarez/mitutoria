@page "/Classroom/{studentId:int}"
@model miTutoria.Web.Pages.Classroom.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aula de " + Model.StudentName;
}

<main class="page-main">
    <div class="dashboard-header">
        <h1>Aula de @Model.StudentName</h1>
        <div class="dashboard-nav-links">
            <a href="/Dashboard">← Volver</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <section class="material-section">
        <details @(string.IsNullOrEmpty(Model.Material) ? "" : "open")>
            <summary class="material-summary">
                @(string.IsNullOrEmpty(Model.Material) ? "＋ Pegar material de trabajo" : "📄 Material cargado")
            </summary>
            <form method="post" asp-page-handler="SaveMaterial" class="material-form" enctype="multipart/form-data">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="form-field">
                    <label>Subir PDF</label>
                    <input type="file" name="PdfFile" accept="application/pdf" />
                </div>
                <div class="form-field">
                    <label>O pegá el texto directamente</label>
                    <textarea name="Material" rows="5" placeholder="Pegá acá el texto, enunciado o fotocopia...">@Model.Material</textarea>
                </div>
                @if (!string.IsNullOrEmpty(Model.Material))
                {
                    <p class="material-preview">📄 @Model.Material.Length caracteres cargados</p>
                }
                <div class="form-actions">
                    <button type="submit" class="btn-main" style="font-size:0.85rem; padding:0.5rem 1.2rem;">Guardar material</button>
                    @if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <button type="submit" name="ClearMaterial" value="true" class="btn-secondary">Borrar material</button>
                    }
                </div>
            </form>
        </details>
    </section>

    <section class="chat-history">
        @if (Model.Messages.Count == 0)
        {
            <p class="empty-state">Todavía no hay mensajes en este aula.</p>
        }
        else
        {
            @foreach (var msg in Model.Messages)
            {
                <div class="chat-bubble chat-bubble--@msg.Role.ToString().ToLower()">
                    <span class="chat-bubble__role">@(msg.Role == miTutoria.Web.Data.Entities.Academic.MessageRole.User ? Model.StudentName : "Tutor")</span>
                    <p>@msg.Content</p>
                </div>
            }
        }
    </section>

    <form method="post" class="chat-form">
        <input type="hidden" name="StudentId" value="@Model.StudentId" />
        <div class="chat-input-row">
            <textarea name="Content" rows="3" placeholder="Escribí tu pregunta..." required></textarea>
            <button type="submit" class="btn-main">Enviar</button>
        </div>
    </form>
</main>
