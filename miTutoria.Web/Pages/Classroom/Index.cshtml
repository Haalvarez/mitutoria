@page "/Classroom/{studentId:int}"
@model miTutoria.Web.Pages.Classroom.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aula · " + Model.StudentName;
    var initial = (Model.StudentName.Length > 0 ? Model.StudentName[0].ToString() : "?").ToUpper();
}

<div class="classroom-layout">

    @* ── SIDEBAR ─────────────────────────────────────────────────── *@
    <aside class="classroom-sidebar">

        <div class="sidebar-header">
            <span class="sidebar-title">@Model.StudentName</span>
            @if (Model.StreakDays >= 1)
            {
                <span class="sidebar-streak" title="@Model.StreakDays día@(Model.StreakDays > 1 ? "s" : "") seguido@(Model.StreakDays > 1 ? "s" : "") estudiando">
                    🔥 @Model.StreakDays
                </span>
            }
            <form method="post" asp-page-handler="NewSession">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <button type="submit" class="sidebar-new-session" title="Nueva sesión">↺</button>
            </form>
        </div>

        @if (!string.IsNullOrEmpty(Model.CompactSummary))
        {
            <div class="sidebar-summary">
                <span class="sidebar-summary__label">📝 Sesión anterior</span>
                <p>@Model.CompactSummary</p>
            </div>
        }

        @* Material *@
        <details class="sidebar-panel" @(string.IsNullOrEmpty(Model.Material) && Model.Sections.Count == 0 ? "" : "open")>
            <summary>
                <span>
                    @if (Model.Sections.Count > 0)
                    {
                        <text>📄 @Model.OcrSource</text>
                    }
                    else if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <text>📄 Material cargado</text>
                    }
                    else
                    {
                        <text>＋ Material</text>
                    }
                </span>
            </summary>

            @* Progreso de secciones — solo si hay más de una *@
            @if (Model.Sections.Count > 1)
            {
                <div class="section-progress" id="section-progress">
                    @for (int i = 0; i < Model.Sections.Count; i++)
                    {
                        var state = i < Model.SectionIndex ? "done" : i == Model.SectionIndex ? "current" : "pending";
                        var icon  = i < Model.SectionIndex ? "✅" : i == Model.SectionIndex ? "▶" : "○";
                        <div class="section-item section-item--@state">
                            <span class="section-icon">@icon</span>
                            <span class="section-title">@Model.Sections[i].Title</span>
                        </div>
                    }
                </div>
                <div class="section-nav" id="section-nav">
                    <button id="btn-prev-section" class="btn-secondary btn-sm"
                            @(Model.SectionIndex == 0 ? "disabled" : "")>← Anterior</button>
                    <span class="section-counter" id="section-counter">@(Model.SectionIndex + 1) / @Model.Sections.Count</span>
                    <button id="btn-next-section" class="btn-secondary btn-sm"
                            @(Model.SectionIndex >= Model.Sections.Count - 1 ? "disabled" : "")>Siguiente →</button>
                </div>
            }
            else if (Model.Sections.Count == 1)
            {
                <p class="sidebar-hint" style="margin:.4rem 0 .6rem;">📌 @Model.Sections[0].Title</p>
            }

            @* PDF — upload AJAX *@
            <div class="sidebar-form" id="pdf-section" style="margin-top:.6rem;">
                <label class="sidebar-label" for="pdf-input">
                    @(Model.Sections.Count > 0 ? "Reemplazar PDF" : "Subir PDF") <small>(máx. 20 MB)</small>
                </label>
                <input type="file" name="PdfFile" accept="application/pdf" id="pdf-input" />
                <div id="pdf-status" style="display:none;" class="sidebar-hint"></div>
            </div>

            @* Apunte extra (complementario, no reemplaza el PDF) *@
            <form method="post" asp-page-handler="SaveMaterial" enctype="multipart/form-data"
                  class="sidebar-form" style="margin-top:.6rem;">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <label class="sidebar-label">
                    @(Model.Sections.Count > 0 ? "📝 Apunte extra del docente" : "O pegá el texto")
                </label>
                <textarea name="Material" rows="3"
                    placeholder="@(Model.Sections.Count > 0 ? "Instrucción puntual, ejercicio, nota de la profe..." : "Enunciado, fotocopia...")">@(Model.Sections.Count > 0 ? string.Empty : Model.Material)</textarea>
                <div class="sidebar-form-actions">
                    <button type="submit" class="btn-main btn-sm">Guardar</button>
                    @if (!string.IsNullOrEmpty(Model.Material) && Model.Sections.Count == 0)
                    {
                        <button type="submit" name="ClearMaterial" value="true" class="btn-secondary btn-sm">Borrar</button>
                    }
                </div>
            </form>
        </details>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="form-errors" style="margin-top:auto;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <p>@error.ErrorMessage</p> }
            </div>
        }

    </aside>

    @* ── CHAT ─────────────────────────────────────────────────────── *@
    <div class="classroom-chat">

        <div class="chat-messages" id="chat-messages">
            @if (Model.Messages.Count == 0)
            {
                <p class="empty-state" style="margin:auto; text-align:center;">Todavía no hay mensajes.<br>¡Escribí algo para empezar!</p>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    var isUser = msg.Role == miTutoria.Web.Data.Entities.Academic.MessageRole.User;
                    var roleClass = isUser ? "user" : "assistant";
                    var label = isUser ? Model.StudentName : "Tutor";
                    var avatarLetter = isUser ? initial : "T";
                    <div class="msg msg--@roleClass">
                        <div class="msg__avatar msg__avatar--@roleClass">@avatarLetter</div>
                        <div class="msg__body">
                            <span class="msg__label">@label</span>
                            <div class="msg__bubble">@msg.Content</div>
                        </div>
                    </div>
                }
            }

            @* Typing indicator *@
            <div class="msg msg--assistant" id="typing-indicator" style="display:none;">
                <div class="msg__avatar msg__avatar--assistant">T</div>
                <div class="msg__body">
                    <span class="msg__label">Tutor</span>
                    <div class="msg__bubble typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="chat-toolbar" id="chat-toolbar">
            <button id="btn-quiz" class="toolbar-btn" title="Quiz rápido con 5 preguntas sobre el material">Quiz</button>
            <button id="btn-cards" class="toolbar-btn" title="Tarjetas para repasar los conceptos clave">Tarjetas</button>
            <button id="btn-exam" class="toolbar-btn" title="Practicá con preguntas de opción múltiple como en un examen real">Examen de práctica</button>
        </div>

        <div class="chat-input-bar">
            <div class="chat-input-row">
                <textarea id="chat-input" rows="1"
                    placeholder="Escribí tu pregunta... (Enter para enviar, Shift+Enter para nueva línea)"></textarea>
                <button id="chat-send" class="chat-send-btn" title="Enviar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            <p class="chat-hint">Ctrl+Enter también envía</p>
        </div>
    </div>
</div>

@* Modal de simulacro *@
<div id="exam-modal" class="cards-modal" style="display:none;" role="dialog" aria-modal="true">
    <div class="cards-modal__backdrop"></div>
    <div class="cards-modal__box">
        <button class="cards-modal__close" id="exam-close" aria-label="Cerrar">✕</button>
        <div class="cards-modal__counter" id="exam-counter"></div>
        <div class="exam-modal__question" id="exam-question"></div>
        <div class="exam-modal__options" id="exam-options"></div>
        <div id="exam-result" style="display:none;"></div>
    </div>
</div>

@* Modal de tarjetas *@
<div id="cards-modal" class="cards-modal" style="display:none;" role="dialog" aria-modal="true">
    <div class="cards-modal__backdrop"></div>
    <div class="cards-modal__box">
        <button class="cards-modal__close" id="cards-close" aria-label="Cerrar">✕</button>
        <div class="cards-modal__counter" id="cards-counter"></div>
        <div class="cards-modal__card" id="cards-card">
            <div class="cards-modal__face" id="cards-face">
                <span class="cards-modal__face-label" id="cards-face-label">Frente</span>
                <p id="cards-text"></p>
            </div>
            <button class="cards-modal__flip" id="cards-flip">Ver respuesta</button>
        </div>
        <div class="cards-modal__nav">
            <button id="cards-prev">← Anterior</button>
            <button id="cards-next">Siguiente →</button>
        </div>
    </div>
</div>

<script>
const studentId = @Model.StudentId;
const studentName = '@Html.Raw(Model.StudentName)';
const initial = '@initial';

const messagesEl = document.getElementById('chat-messages');
const inputEl    = document.getElementById('chat-input');
const sendBtn    = document.getElementById('chat-send');
const typing     = document.getElementById('typing-indicator');

// Auto-scroll al fondo
function scrollBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
scrollBottom();

// Auto-resize del textarea
inputEl.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 160) + 'px';
});

// Enter envía, Shift+Enter nueva línea
inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});
sendBtn.addEventListener('click', sendMessage);

function addBubble(text, role) {
    const isUser = role === 'user';
    const label  = isUser ? studentName : 'Tutor';
    const av     = isUser ? initial : 'T';
    const div = document.createElement('div');
    div.className = `msg msg--${role}`;
    div.innerHTML = `
        <div class="msg__avatar msg__avatar--${role}">${av}</div>
        <div class="msg__body">
            <span class="msg__label">${label}</span>
            <div class="msg__bubble">${text.replace(/\n/g, '<br>')}</div>
        </div>`;
    messagesEl.insertBefore(div, typing);
    scrollBottom();
}

// Upload PDF vía AJAX
document.getElementById('pdf-input').addEventListener('change', async function() {
    if (!this.files.length) return;
    const file = this.files[0];
    const statusEl = document.getElementById('pdf-status');
    const input = this;

    statusEl.style.display = 'block';
    statusEl.textContent = 'Subiendo y leyendo el PDF…';
    input.disabled = true;

    const formData = new FormData();
    formData.append('StudentId', studentId);
    formData.append('PdfFile', file);

    try {
        const res = await fetch(`/Classroom/${studentId}?handler=SaveMaterial`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrf() },
            body: formData
        });
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        if (data.error) {
            statusEl.textContent = data.error;
        } else {
            statusEl.textContent = '✓ ' + (data.chars ? `${data.chars.toLocaleString()} caracteres cargados` : 'Material cargado');
            document.querySelector('.sidebar-panel summary span').textContent = '📄 Material cargado';
            messagesEl.querySelector('.empty-state')?.remove();
            addBubble(data.reply || '¡Material cargado! Escribime cuando estés listo para arrancar.', 'assistant');
        }
    } catch(e) {
        statusEl.textContent = 'Error al subir. Intentá de nuevo.';
    } finally {
        input.disabled = false;
        input.value = '';
    }
});

const btnQuiz  = document.getElementById('btn-quiz');
const btnCards = document.getElementById('btn-cards');
const btnExam  = document.getElementById('btn-exam');
let isExamMode = @(Model.IsExamMode ? "true" : "false");

const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content ?? '';

async function toolbarAction(handler, label) {
    btnQuiz.disabled = btnCards.disabled = btnExam.disabled = true;
    messagesEl.querySelector('.empty-state')?.remove();
    typing.style.display = 'flex';
    scrollBottom();
    try {
        const res = await fetch(`/Classroom/${studentId}?handler=${handler}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
            body: new URLSearchParams({ studentId })
        });
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        typing.style.display = 'none';
        if (data.type === 'flashcards') {
            addFlashcards(data.cards);
        } else if (data.type === 'exam' || data.type === 'quiz') {
            openExam(data.questions, label);
        } else if (data.reply) {
            addBubble(data.reply, 'assistant');
        } else {
            addBubble('Error: ' + (data.error ?? 'sin respuesta'), 'assistant');
        }
    } catch(e) {
        typing.style.display = 'none';
        addBubble('Error de conexión. Intentá de nuevo.', 'assistant');
    } finally {
        btnQuiz.disabled = btnCards.disabled = btnExam.disabled = false;
    }
}

// Modal de tarjetas
let _cards = [], _cardIdx = 0, _showingBack = false;

function addFlashcards(cards) {
    // Burbuja en el chat con botón para abrir
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.innerHTML = `
        <div class="msg__avatar msg__avatar--assistant">T</div>
        <div class="msg__body">
            <span class="msg__label">Tutor</span>
            <div class="msg__bubble">
                Armé ${cards.length} tarjetas de estudio.
                <br><button class="btn-main btn-sm" style="margin-top:.5rem" onclick="openCards()">📇 Abrir tarjetas</button>
            </div>
        </div>`;
    messagesEl.insertBefore(wrap, typing);
    scrollBottom();
    _cards = cards;
    openCards();
}

function openCards() {
    if (!_cards.length) return;
    _cardIdx = 0;
    renderCard();
    document.getElementById('cards-modal').style.display = 'flex';
}

function renderCard() {
    _showingBack = false;
    const c = _cards[_cardIdx];
    document.getElementById('cards-counter').textContent = `${_cardIdx + 1} / ${_cards.length}`;
    document.getElementById('cards-text').textContent = c.front;
    document.getElementById('cards-face-label').textContent = 'Frente';
    document.getElementById('cards-card').classList.remove('showing-back');
    document.getElementById('cards-flip').textContent = 'Ver respuesta';
    document.getElementById('cards-prev').disabled = _cardIdx === 0;
    document.getElementById('cards-next').disabled = _cardIdx === _cards.length - 1;
}

document.getElementById('cards-flip').addEventListener('click', () => {
    const c = _cards[_cardIdx];
    _showingBack = !_showingBack;
    document.getElementById('cards-text').textContent = _showingBack ? c.back : c.front;
    document.getElementById('cards-face-label').textContent = _showingBack ? 'Dorso' : 'Frente';
    document.getElementById('cards-card').classList.toggle('showing-back', _showingBack);
    document.getElementById('cards-flip').textContent = _showingBack ? 'Ver pregunta' : 'Ver respuesta';
});
document.getElementById('cards-prev').addEventListener('click', () => { if (_cardIdx > 0) { _cardIdx--; renderCard(); } });
document.getElementById('cards-next').addEventListener('click', () => { if (_cardIdx < _cards.length - 1) { _cardIdx++; renderCard(); } });
document.getElementById('cards-close').addEventListener('click', () => { document.getElementById('cards-modal').style.display = 'none'; });
document.querySelector('#cards-modal .cards-modal__backdrop').addEventListener('click', () => { document.getElementById('cards-modal').style.display = 'none'; });

// Simulacro de examen
let _questions = [], _qIdx = 0, _score = 0, _answered = [];

function openExam(questions, label) {
    _questions = questions;
    _qIdx = 0; _score = 0; _answered = [];
    const title = label || 'Examen de práctica';
    renderQuestion(title);
    document.getElementById('exam-modal').style.display = 'flex';
    // Burbuja en el chat
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.innerHTML = `<div class="msg__avatar msg__avatar--assistant">T</div>
        <div class="msg__body"><span class="msg__label">Tutor</span>
        <div class="msg__bubble">📝 ${title} listo — ${questions.length} preguntas.
        <br><button class="btn-main btn-sm" style="margin-top:.5rem" onclick="document.getElementById('exam-modal').style.display='flex'">Retomar ${title.toLowerCase()}</button>
        </div></div>`;
    messagesEl.insertBefore(wrap, typing);
    scrollBottom();
}

function renderQuestion(title) {
    const q = _questions[_qIdx];
    const label = title || 'Examen de práctica';
    document.getElementById('exam-counter').textContent = `${label} · Pregunta ${_qIdx + 1} de ${_questions.length}`;
    document.getElementById('exam-question').textContent = q.question;
    document.getElementById('exam-result').style.display = 'none';
    const opts = document.getElementById('exam-options');
    opts.innerHTML = '';
    ['a','b','c','d'].forEach(k => {
        if (!q.options[k]) return;
        const btn = document.createElement('button');
        btn.className = 'exam-option';
        btn.innerHTML = `<strong>${k})</strong> ${q.options[k]}`;
        btn.addEventListener('click', () => selectOption(k, btn));
        opts.appendChild(btn);
    });
}

function selectOption(key, btn) {
    const q = _questions[_qIdx];
    const correct = q.correct?.toLowerCase();
    document.querySelectorAll('.exam-option').forEach(b => b.disabled = true);
    btn.classList.add(key === correct ? 'exam-option--correct' : 'exam-option--wrong');
    if (key !== correct)
        document.querySelectorAll('.exam-option').forEach(b => {
            if (b.textContent.trim().startsWith(correct + ')') || b.innerHTML.includes(`>${correct})<`)) b.classList.add('exam-option--correct');
        });
    _answered.push({ q: q.question, selected: key, correct });
    if (key === correct) _score++;

    const resultEl = document.getElementById('exam-result');
    resultEl.style.display = 'block';
    if (_qIdx < _questions.length - 1) {
        resultEl.innerHTML = `<button class="btn-main btn-sm" id="exam-next-btn">Siguiente →</button>`;
        document.getElementById('exam-next-btn').addEventListener('click', () => { _qIdx++; renderQuestion(); });
    } else {
        const pct = Math.round(_score / _questions.length * 100);
        resultEl.innerHTML = `<div class="exam-score">
            <strong>${_score}/${_questions.length} correctas (${pct}%)</strong>
            <p>${pct >= 70 ? '¡Muy bien! Estás listo/a.' : pct >= 50 ? 'Bien, pero hay conceptos para repasar.' : 'Hay bastante para repasar. ¿Arrancamos?'}</p>
            <button class="btn-main btn-sm" onclick="document.getElementById('exam-modal').style.display='none'">Cerrar</button>
        </div>`;
    }
}

document.getElementById('exam-close').addEventListener('click', () => { document.getElementById('exam-modal').style.display = 'none'; });
document.querySelector('#exam-modal .cards-modal__backdrop').addEventListener('click', () => { document.getElementById('exam-modal').style.display = 'none'; });

btnQuiz.addEventListener('click',  () => toolbarAction('Quiz',       'Quiz'));
btnCards.addEventListener('click', () => toolbarAction('Flashcards', 'Tarjetas'));
btnExam.addEventListener('click',  () => toolbarAction('Exam',       'Examen de práctica'));

// Navegación de secciones
const btnPrev = document.getElementById('btn-prev-section');
const btnNext = document.getElementById('btn-next-section');

async function advanceSection(direction) {
    const res = await fetch(`/Classroom/${studentId}?handler=AdvanceSection`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
        body: new URLSearchParams({ studentId, direction })
    });
    if (!res.ok) return;
    const data = await res.json();
    // Actualizar contador
    const counter = document.getElementById('section-counter');
    if (counter) counter.textContent = `${data.index + 1} / ${data.total}`;
    // Recargar sidebar para reflejar estado visual
    location.reload();
}

if (btnPrev) btnPrev.addEventListener('click', () => advanceSection('prev'));
if (btnNext) btnNext.addEventListener('click', () => advanceSection('next'));

async function sendMessage() {
    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = '';
    inputEl.style.height = 'auto';
    inputEl.disabled = true;
    sendBtn.disabled = true;

    // Quitar empty-state si existe
    messagesEl.querySelector('.empty-state')?.remove();

    addBubble(text, 'user');
    typing.style.display = 'flex';
    scrollBottom();

    try {
        const body = new URLSearchParams({ content: text });
        const res = await fetch(`/Classroom/${studentId}?handler=Send`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('meta[name="csrf-token"]')?.content ?? ''
            },
            body
        });

        if (res.status === 401) { location.href = '/Login'; return; }

        const data = await res.json();
        typing.style.display = 'none';

        if (data.reply) addBubble(data.reply, 'assistant');
        else addBubble('Error: ' + (data.error ?? 'sin respuesta'), 'assistant');

    } catch(e) {
        typing.style.display = 'none';
        addBubble('Error de conexión. Intentá de nuevo.', 'assistant');
    } finally {
        inputEl.disabled = false;
        sendBtn.disabled = false;
        inputEl.focus();
    }
}
</script>
