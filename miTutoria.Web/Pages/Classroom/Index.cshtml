@page "/Classroom/{studentId:int}"
@model miTutoria.Web.Pages.Classroom.IndexModel
@using miTutoria.Web.Inbox
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aula · " + Model.StudentName;
    var initial = (Model.StudentName.Length > 0 ? Model.StudentName[0].ToString() : "?").ToUpper();
    var tutorAvatar   = string.IsNullOrEmpty(Model.TutorAvatar) ? "T" : Model.TutorAvatar;
    var studentAvatar = string.IsNullOrEmpty(Model.StudentAvatar) ? initial : Model.StudentAvatar;
    var tutorLabel    = string.IsNullOrEmpty(Model.TutorName) ? "Tutor" : Model.TutorName;
    ViewData["StudentId"] = Model.StudentId;   // lo usan los botones del partial _AgendaItem
    ViewData["StudentClassroomEmail"] = Model.StudentClassroomEmail;   // abre Classroom en la cuenta correcta
}
@functions {
    // Texto plano de verdad: saca markdown (** * __ _) y escapa HTML; \n → <br>
    static string FormatMessage(string? raw)
    {
        var s = System.Net.WebUtility.HtmlEncode(raw ?? "");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*\*(.+?)\*\*", "$1");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*(.+?)\*", "$1");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"__(.+?)__", "$1");
        return s.Replace("\n", "<br>");
    }
}

<div class="classroom-layout">

    @* ── SIDEBAR ─────────────────────────────────────────────────── *@
    <aside class="classroom-sidebar">

        <div class="sidebar-header">
            <span class="sidebar-title">@Model.StudentName</span>
            @if (Model.StreakDays >= 1)
            {
                <span class="sidebar-streak" title="@Model.StreakDays día@(Model.StreakDays > 1 ? "s" : "") seguido@(Model.StreakDays > 1 ? "s" : "") estudiando">
                    🔥 @Model.StreakDays
                </span>
            }
            <form method="post" asp-page-handler="NewSession">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <button type="submit" class="sidebar-new-session" title="Nueva sesión">↺</button>
            </form>
        </div>

        @* ── Mochila: selector de materia ─────────────────────────────── *@
        <div class="sidebar-mochila">
            <label class="sidebar-label">🎒 Materia</label>
            <form method="post" asp-page-handler="SwitchSubject" id="switch-subject-form">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <select name="classroomId" class="mochila-select"
                        onchange="document.getElementById('switch-subject-form').submit()">
                    @foreach (var s in Model.Subjects)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.ActiveClassroomId)">@s.Name</option>
                    }
                </select>
            </form>
            <details class="mochila-new">
                <summary>＋ Nueva materia</summary>
                <form method="post" asp-page-handler="CreateSubject" class="sidebar-form" style="margin-top:.4rem;">
                    <input type="hidden" name="StudentId" value="@Model.StudentId" />
                    <input type="text" name="subjectName" maxlength="40" autocomplete="off"
                           placeholder="Historia, Matemática, Francés..." required />
                    <button type="submit" class="btn-main btn-sm" style="margin-top:.4rem;">Crear materia</button>
                </form>
            </details>
        </div>

        @* ── Agenda del aula (Track 2, gateada por flag) ──────────────── *@
        @if (Model.InboxEnabled)
        {
            <details class="sidebar-panel agenda-panel" open>
                <summary>
                    <span>📅 Agenda@(Model.Agenda.Count > 0 ? $" · {Model.Agenda.Count}" : "")</span>
                </summary>
                @if (Model.Agenda.Count > 0)
                {
                    <div class="agenda-toolbar">
                        <button type="button" id="focus-toggle" class="agenda-mode-btn"
                                data-adhd="@(Model.StudentHasAdhd ? "1" : "0")" onclick="toggleFocusMode(this)">🎯 Modo foco</button>
                        <button type="button" class="btn-main btn-sm" onclick="priorityToday()">📋 Mis prioridades</button>
                    </div>
                }
                @if (Model.Agenda.Count == 0)
                {
                    <p class="sidebar-hint" style="margin:.4rem 0;">Sin novedades del aula todavía.</p>
                }
                else
                {
                    var today = DateTime.UtcNow.Date;
                    Func<IndexModel.AgendaItem, bool> isTask = a =>
                        a.Type == ClassroomItemType.Assignment || a.Type == ClassroomItemType.DueReminder;
                    var overdue  = Model.Agenda.Where(a => !a.Done && isTask(a) && a.DueDate.HasValue && a.DueDate.Value.Date <= today).ToList();
                    var upcoming = Model.Agenda.Where(a => !a.Done && isTask(a) && (!a.DueDate.HasValue || a.DueDate.Value.Date > today)).ToList();
                    var anuncios = Model.Agenda.Where(a => !a.Done && !isTask(a)).ToList();

                    if (overdue.Count > 0)
                    {
                        <div class="agenda-group">
                            <div class="agenda-group__title agenda-group__title--red">🔴 Vencido / hoy</div>
                            <ul class="agenda-list">
                                @foreach (var a in overdue)
                                {
                                    <partial name="_AgendaItem" model="a" />
                                }
                            </ul>
                        </div>
                    }
                    if (upcoming.Count > 0)
                    {
                        <div class="agenda-group agenda-group--upcoming">
                            <div class="agenda-group__title agenda-group__title--yellow">📌 Próximas entregas</div>
                            <ul class="agenda-list">
                                @foreach (var a in upcoming)
                                {
                                    <partial name="_AgendaItem" model="a" />
                                }
                            </ul>
                        </div>
                    }
                    if (overdue.Count == 0 && upcoming.Count == 0)
                    {
                        <p class="sidebar-hint" style="margin:.4rem 1rem;">Sin entregas pendientes. 🎉</p>
                    }
                    if (anuncios.Count > 0)
                    {
                        <details class="agenda-group agenda-anuncios"@(Model.StudentHasAdhd ? "" : " open")>
                            <summary class="agenda-group__title agenda-group__title--info">📨 Anuncios · @anuncios.Count</summary>
                            <form method="post" asp-page-handler="MarkAnnouncementsRead" style="margin:.3rem 1rem;">
                                <input type="hidden" name="studentId" value="@Model.StudentId" />
                                <button type="submit" class="btn-secondary btn-sm">Marcar todos leídos</button>
                            </form>
                            <ul class="agenda-list">
                                @foreach (var a in anuncios)
                                {
                                    <partial name="_AgendaItem" model="a" />
                                }
                            </ul>
                        </details>
                    }
                }
                <p class="agenda-disclaimer">⚠️ Lectura automática del aula — puede fallar. Confirmá siempre en Classroom.</p>
            </details>
        }

        @* El resumen de la sesión anterior (CompactSummary) es interno: se inyecta al
           prompt en silencio y NO se le muestra al alumno. Su lugar como feedback es
           el panel del padre, no la barra lateral del aula. *@

        @* Material *@
        <details class="sidebar-panel" @(string.IsNullOrEmpty(Model.Material) && Model.Sections.Count == 0 ? "" : "open")>
            <summary>
                <span>
                    @if (Model.Sections.Count > 0)
                    {
                        <text>📄 @Model.OcrSource</text>
                    }
                    else if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <text>📄 Material cargado</text>
                    }
                    else
                    {
                        <text>＋ Material</text>
                    }
                </span>
            </summary>

            @* Progreso de secciones — solo si hay más de una *@
            @if (Model.Sections.Count > 1)
            {
                <div class="section-progress" id="section-progress">
                    @for (int i = 0; i < Model.Sections.Count; i++)
                    {
                        var state = i < Model.SectionIndex ? "done" : i == Model.SectionIndex ? "current" : "pending";
                        var icon  = i < Model.SectionIndex ? "✅" : i == Model.SectionIndex ? "▶" : "○";
                        <div class="section-item section-item--@state">
                            <span class="section-icon">@icon</span>
                            <span class="section-title">@Model.Sections[i].Title</span>
                        </div>
                    }
                </div>
                <div class="section-nav" id="section-nav">
                    <button id="btn-prev-section" class="btn-secondary btn-sm"
                            @(Model.SectionIndex == 0 ? "disabled" : "")>← Anterior</button>
                    <span class="section-counter" id="section-counter">@(Model.SectionIndex + 1) / @Model.Sections.Count</span>
                    <button id="btn-next-section" class="btn-secondary btn-sm"
                            @(Model.SectionIndex >= Model.Sections.Count - 1 ? "disabled" : "")>Siguiente →</button>
                </div>
            }
            else if (Model.Sections.Count == 1)
            {
                <p class="sidebar-hint" style="margin:.4rem 0 .6rem;">📌 @Model.Sections[0].Title</p>
            }

            @* Input de archivo oculto — disparado desde el botón del chat *@
            <input type="file" name="PdfFile" accept="application/pdf,image/jpeg,image/png,image/webp,image/gif" id="pdf-input" style="display:none;" />

            @* Apunte extra (complementario al PDF) *@
            <form method="post" asp-page-handler="SaveMaterial" enctype="multipart/form-data"
                  class="sidebar-form" style="margin-top:.6rem;">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <label class="sidebar-label">
                    @(Model.Sections.Count > 0 ? "📝 Apunte extra" : "Pegá el texto del tema")
                </label>
                <textarea name="Material" rows="3"
                    placeholder="@(Model.Sections.Count > 0 ? "Nota de la profe, ejercicio puntual..." : "Enunciado, apunte, fotocopia...")">@(Model.Sections.Count > 0 ? string.Empty : Model.Material)</textarea>
                <div class="sidebar-form-actions">
                    <button type="submit" class="btn-main btn-sm">Guardar</button>
                    @if (!string.IsNullOrEmpty(Model.Material) || Model.Sections.Count > 0)
                    {
                        <button type="submit" name="ClearMaterial" value="true" class="btn-secondary btn-sm">Borrar</button>
                    }
                </div>
            </form>
        </details>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="form-errors" style="margin-top:auto;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <p>@error.ErrorMessage</p> }
            </div>
        }

    </aside>

    @* ── CHAT ─────────────────────────────────────────────────────── *@
    <div class="classroom-chat" id="classroom-chat">
        @if (Model.UrgentAgenda.Count > 0)
        {
            <div class="aula-banner" id="aula-banner">
                <span class="aula-banner__icon">⏰</span>
                <div class="aula-banner__text">
                    <strong>Para entregar pronto:</strong>
                    @string.Join(" · ", Model.UrgentAgenda.Select(u =>
                        u.Title + (string.IsNullOrEmpty(u.DueDateRaw) ? "" : $" ({u.DueDateRaw})")))
                </div>
                <button type="button" class="aula-banner__close" title="Cerrar"
                        onclick="this.parentElement.style.display='none'">✕</button>
            </div>
        }
        <div id="drop-overlay" class="drop-overlay" style="display:none;">
            <div class="drop-overlay__inner">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
                <p>Soltá el PDF o la foto acá</p>
            </div>
        </div>

        <div class="chat-messages" id="chat-messages">
            @if (Model.Messages.Count == 0)
            {
                <p class="empty-state" style="margin:auto; text-align:center;">Todavía no hay mensajes.<br>¡Escribí algo para empezar!</p>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    var isUser = msg.Role == miTutoria.Web.Data.Entities.Academic.MessageRole.User;
                    var roleClass = isUser ? "user" : "assistant";
                    var label = isUser ? Model.StudentName : tutorLabel;
                    var avatarLetter = isUser ? studentAvatar : tutorAvatar;
                    <div class="msg msg--@roleClass">
                        <div class="msg__avatar msg__avatar--@roleClass">@avatarLetter</div>
                        <div class="msg__body">
                            <span class="msg__label">@label</span>
                            <div class="msg__bubble">@Html.Raw(FormatMessage(msg.Content))</div>
                        </div>
                    </div>
                }
            }

            @* Typing indicator *@
            <div class="msg msg--assistant" id="typing-indicator" style="display:none;">
                <div class="msg__avatar msg__avatar--assistant">@tutorAvatar</div>
                <div class="msg__body">
                    <span class="msg__label">@tutorLabel</span>
                    <div class="msg__bubble typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="chat-toolbar" id="chat-toolbar">
            <button id="btn-quiz" class="toolbar-btn" title="Quiz rápido con 5 preguntas sobre el material">Quiz</button>
            <button id="btn-cards" class="toolbar-btn" title="Tarjetas para repasar los conceptos clave">Tarjetas</button>
            <button id="btn-exam" class="toolbar-btn" title="Practicá con preguntas de opción múltiple como en un examen real">Examen de práctica</button>
            @if (Model.PodcastEnabled)
            {
                <button id="btn-podcast" class="toolbar-btn" title="Audio-resumen tipo podcast (2 voces) sobre el material">🎧 Podcast</button>
            }
        </div>

        <div class="chat-input-bar">
            <div class="chat-input-row">
                <button id="btn-attach" class="chat-attach-btn" title="Subir PDF o foto">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                </button>
                <textarea id="chat-input" rows="1"
                    placeholder="Escribí tu pregunta... (Enter para enviar, Shift+Enter para nueva línea)">@Model.TutorSeed</textarea>
                <button id="chat-send" class="chat-send-btn" title="Enviar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            <p class="chat-hint">Ctrl+Enter también envía · 📎 para subir PDF o foto</p>
        </div>
    </div>
</div>

@* Modal de simulacro *@
<div id="exam-modal" class="cards-modal" style="display:none;" role="dialog" aria-modal="true">
    <div class="cards-modal__backdrop"></div>
    <div class="cards-modal__box">
        <button class="cards-modal__close" id="exam-close" aria-label="Cerrar">✕</button>
        <div class="cards-modal__counter" id="exam-counter"></div>
        <div class="exam-modal__question" id="exam-question"></div>
        <div class="exam-modal__options" id="exam-options"></div>
        <div id="exam-result" style="display:none;"></div>
    </div>
</div>

@* Modal de tarjetas *@
<div id="cards-modal" class="cards-modal" style="display:none;" role="dialog" aria-modal="true">
    <div class="cards-modal__backdrop"></div>
    <div class="cards-modal__box">
        <button class="cards-modal__close" id="cards-close" aria-label="Cerrar">✕</button>
        <div class="cards-modal__counter" id="cards-counter"></div>
        <div class="cards-modal__card" id="cards-card">
            <div class="cards-modal__face" id="cards-face">
                <span class="cards-modal__face-label" id="cards-face-label">Frente</span>
                <p id="cards-text"></p>
            </div>
            <button class="cards-modal__flip" id="cards-flip">Ver respuesta</button>
        </div>
        <div class="cards-modal__nav">
            <button id="cards-prev">← Anterior</button>
            <button id="cards-next">Siguiente →</button>
        </div>
    </div>
</div>

@if (Model.AttentionEnabled)
{
    <text>
    <script>
    // ── Atención dedicada ── Mide tiempo concentrado vs ausente de la pestaña del Aula.
    // focused = visible + ventana enfocada + input reciente | idle = sin input > umbral (se descarta)
    // away    = pestaña oculta o ventana sin foco (se fue a otra pestaña/app). Solo lo ve el padre.
    (function () {
        const IDLE_MS = 3 * 60 * 1000;       // sin input por > 3 min mientras está visible → idle (no cuenta)
        const AWAY_CAP_MS = 8 * 60 * 1000;   // tope por tramo de ausencia: "se fue y no volvió" (Netflix) no acumula horas
        const MIN_AWAY_MS = 10 * 1000;       // una "salida" cuenta solo si la ausencia duró > 10s (filtra micro-blurs)
        const BEAT_MS = 15 * 1000;           // reporta cada 15s
        const key = (crypto.randomUUID && crypto.randomUUID()) ||
                    (Date.now() + '-' + Math.random().toString(36).slice(2));

        let focusedMs = 0, idleMs = 0, awayMs = 0, interruptions = 0;
        let awayStretchMs = 0;               // duración del tramo de ausencia actual (para aplicar el tope)
        let lastEval = Date.now();
        let lastInput = Date.now();
        let lastState = 'focused';

        function stateNow() {
            if (document.hidden || !document.hasFocus()) return 'away';
            return (Date.now() - lastInput) > IDLE_MS ? 'idle' : 'focused';
        }
        function evaluate() {
            const now = Date.now();
            const delta = now - lastEval;
            if (delta > 0) {
                if (lastState === 'focused') focusedMs += delta;
                else if (lastState === 'idle') idleMs += delta;
                else {
                    // Solo cuenta hasta AWAY_CAP_MS por tramo: la ausencia "final" no hunde el %.
                    awayMs += Math.min(delta, Math.max(0, AWAY_CAP_MS - awayStretchMs));
                    awayStretchMs += delta;
                }
            }
            const next = stateNow();
            // La "salida" se cuenta al VOLVER y solo si la ausencia fue significativa (> MIN_AWAY_MS):
            // así un blur accidental / notificación / alt-tab de 1s no infla el contador.
            if (next !== 'away' && lastState === 'away' && awayStretchMs >= MIN_AWAY_MS) interruptions++;
            if (next === 'away' && lastState !== 'away') awayStretchMs = 0;   // arranca un nuevo tramo de ausencia
            lastState = next;
            lastEval = now;
        }
        function onInput() { lastInput = Date.now(); }
        ['mousemove', 'keydown', 'scroll', 'click', 'touchstart'].forEach(
            ev => window.addEventListener(ev, onInput, { passive: true }));

        function payload() {
            return JSON.stringify({ key, focusedMs, idleMs, awayMs, interruptions });
        }
        function beat(useBeacon) {
            evaluate();
            try {
                if (useBeacon && navigator.sendBeacon) {
                    navigator.sendBeacon('/api/attention/beat',
                        new Blob([payload()], { type: 'application/json' }));
                } else {
                    fetch('/api/attention/beat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload(), keepalive: true
                    }).catch(() => {});
                }
            } catch (e) { /* silencioso */ }
        }

        setInterval(evaluate, 1000);          // contabiliza con grano fino mientras la pestaña vive
        setInterval(() => beat(false), BEAT_MS);
        document.addEventListener('visibilitychange', () => beat(true));
        window.addEventListener('blur', evaluate);
        window.addEventListener('focus', evaluate);
        window.addEventListener('pagehide', () => beat(true));
    })();
    </script>
    </text>
}

<script>
const studentId = @Model.StudentId;
const studentName = '@Html.Raw(Model.StudentName)';
const initial = '@initial';
const tutorAv    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tutorAvatar));
const studentAv  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(studentAvatar));
const tutorLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tutorLabel));
// Saca markdown (** * __) — el tutor debe hablar en texto plano
function plainText(t){ return (t || '').replace(/\*\*(.+?)\*\*/g,'$1').replace(/\*(.+?)\*/g,'$1').replace(/__(.+?)__/g,'$1'); }

const messagesEl = document.getElementById('chat-messages');
const inputEl    = document.getElementById('chat-input');
const sendBtn    = document.getElementById('chat-send');
const typing     = document.getElementById('typing-indicator');

// Auto-scroll al fondo
function scrollBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
scrollBottom();

// Auto-resize del textarea
inputEl.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 160) + 'px';
});

// Enter envía, Shift+Enter nueva línea
inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});
sendBtn.addEventListener('click', sendMessage);

function addBubble(text, role) {
    const isUser = role === 'user';
    const label  = isUser ? studentName : tutorLabel;
    const av     = isUser ? studentAv : tutorAv;
    const div = document.createElement('div');
    div.className = `msg msg--${role}`;
    div.innerHTML = `
        <div class="msg__avatar msg__avatar--${role}">${av}</div>
        <div class="msg__body">
            <span class="msg__label">${label}</span>
            <div class="msg__bubble">${plainText(text).replace(/\n/g, '<br>')}</div>
        </div>`;
    messagesEl.insertBefore(div, typing);
    scrollBottom();
}

// Botón adjuntar → dispara el input oculto
document.getElementById('btn-attach').addEventListener('click', () => {
    document.getElementById('pdf-input').click();
});

// Drag & drop sobre el área del chat
const chatEl    = document.getElementById('classroom-chat');
const dropOverlay = document.getElementById('drop-overlay');
let _dragCounter = 0;

chatEl.addEventListener('dragenter', e => {
    if (!e.dataTransfer.types.includes('Files')) return;
    e.preventDefault();
    _dragCounter++;
    dropOverlay.style.display = 'flex';
});
chatEl.addEventListener('dragleave', () => {
    _dragCounter--;
    if (_dragCounter <= 0) { _dragCounter = 0; dropOverlay.style.display = 'none'; }
});
chatEl.addEventListener('dragover', e => e.preventDefault());
chatEl.addEventListener('drop', e => {
    e.preventDefault();
    _dragCounter = 0;
    dropOverlay.style.display = 'none';
    const file = e.dataTransfer.files[0];
    if (!file || !isAcceptedMaterial(file)) {
        addBubble('Puedo leer PDFs o fotos (JPG, PNG, WebP). Probá de nuevo 😊', 'assistant');
        return;
    }
    uploadPdf(file);
});

function isAcceptedMaterial(file) {
    if (file.type === 'application/pdf') return true;
    if (['image/jpeg', 'image/png', 'image/webp', 'image/gif'].includes(file.type)) return true;
    // Fallback por extensión si el navegador no informa el type
    return /\.(pdf|jpe?g|png|webp|gif)$/i.test(file.name || '');
}

async function uploadPdf(file) {
    document.getElementById('btn-attach').disabled = true;
    document.getElementById('pdf-input').disabled = true;
    startUploadAnimation(file.name);

    const formData = new FormData();
    formData.append('StudentId', studentId);
    formData.append('PdfFile', file);

    try {
        const res = await fetch(`/Classroom/${studentId}?handler=SaveMaterial`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrf() },
            body: formData
        });
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        if (data.error) {
            stopUploadAnimation('❌ ' + data.error);
        } else {
            stopUploadAnimation(data.reply || '¡Material cargado! Escribime cuando estés listo para arrancar.');
            setTimeout(() => location.reload(), 1200);
        }
    } catch {
        stopUploadAnimation('Hubo un problema al subir el archivo. Intentá de nuevo.');
    } finally {
        document.getElementById('btn-attach').disabled = false;
        document.getElementById('pdf-input').disabled = false;
        document.getElementById('pdf-input').value = '';
    }
}

// Mensajes animados durante la carga del PDF
const uploadMessages = [
    'Dame un momento, estoy abriendo tu archivo...',
    'Leyendo página por página... hay bastante para ver 👀',
    'Esto se ve interesante, seguí...',
    'Procesando el contenido, ya casi...',
    'Identificando los temas principales...',
    'Armando todo para que podamos arrancar juntos 🎯',
    'Un poquito más, prometido...',
    'Ya lo tengo casi listo, esperame...',
];

let _uploadBubble = null;
let _uploadMsgInterval = null;

function startUploadAnimation(fileName) {
    messagesEl.querySelector('.empty-state')?.remove();
    _uploadBubble = document.createElement('div');
    _uploadBubble.className = 'msg msg--assistant';
    _uploadBubble.id = 'upload-bubble';
    _uploadBubble.innerHTML = `
        <div class="msg__avatar msg__avatar--assistant">${tutorAv}</div>
        <div class="msg__body">
            <span class="msg__label">${tutorLabel}</span>
            <div class="msg__bubble upload-thinking">
                <span class="upload-icon">📄</span>
                <span class="upload-filename">${fileName}</span>
                <span class="upload-msg" id="upload-msg">${uploadMessages[0]}</span>
            </div>
        </div>`;
    messagesEl.insertBefore(_uploadBubble, typing);
    scrollBottom();

    let idx = 1;
    _uploadMsgInterval = setInterval(() => {
        const el = document.getElementById('upload-msg');
        if (el) { el.style.opacity = '0'; setTimeout(() => { el.textContent = uploadMessages[idx % uploadMessages.length]; el.style.opacity = '1'; idx++; }, 300); }
    }, 2500);
}

function stopUploadAnimation(replyText) {
    clearInterval(_uploadMsgInterval);
    if (_uploadBubble) {
        const bubble = _uploadBubble.querySelector('.msg__bubble');
        bubble.className = 'msg__bubble';
        bubble.innerHTML = plainText(replyText || '').replace(/\n/g, '<br>') || '¡Material cargado! Escribime cuando estés listo para arrancar.';
        _uploadBubble = null;
    }
}

// Upload PDF vía click en input
document.getElementById('pdf-input').addEventListener('change', function() {
    if (!this.files.length) return;
    uploadPdf(this.files[0]);
});

const btnQuiz  = document.getElementById('btn-quiz');
const btnCards = document.getElementById('btn-cards');
const btnExam  = document.getElementById('btn-exam');
let isExamMode = @(Model.IsExamMode ? "true" : "false");

const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content ?? '';

// Agenda: desplegar/ocultar la info extra del ítem (sirve en compu y celu, sin hover).
function toggleAgendaInfo(bodyEl) {
    const d = bodyEl.querySelector('.agenda-item__details');
    const ch = bodyEl.querySelector('.agenda-chevron');
    if (!d) return;
    const show = d.style.display === 'none' || d.style.display === '';
    d.style.display = show ? 'block' : 'none';
    if (ch) ch.textContent = show ? '▴' : '▾';
}

// Agenda: marcar hecho con ventana de "Deshacer" de 10s (estilo Gmail).
const _agendaUndo = {};   // id -> { html, t, tick }
function agendaDone(id, btn) {
    const li = btn.closest('.agenda-item');
    if (!li || _agendaUndo[id]) return;
    let left = 10;
    const html = li.innerHTML;
    li.innerHTML =
        '<div style="display:flex;align-items:center;gap:.5rem;padding:.45rem .3rem;color:#5C7A5E;font-size:.85rem;">' +
        '<span>✓ Marcada como hecha</span>' +
        '<button type="button" onclick="agendaUndo(' + id + ')" style="background:none;border:none;color:#4A7CA0;text-decoration:underline;cursor:pointer;font-size:.85rem;padding:0;">Deshacer</button>' +
        '<span class="agenda-undo-count" style="color:#aaa;">(' + left + ')</span></div>';
    const cnt = li.querySelector('.agenda-undo-count');
    const tick = setInterval(() => { left--; if (cnt) cnt.textContent = left > 0 ? '(' + left + ')' : ''; }, 1000);
    const t = setTimeout(async () => {
        clearInterval(tick); delete _agendaUndo[id];
        try {
            await fetch(`/Classroom/${studentId}?handler=ToggleAgendaDone`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
                body: new URLSearchParams({ studentId, id })
            });
        } catch {}
        const h = li.offsetHeight;
        li.style.overflow = 'hidden'; li.style.maxHeight = h + 'px';
        li.style.transition = 'opacity .2s ease, max-height .25s ease, margin .25s ease, padding .25s ease';
        requestAnimationFrame(() => { li.style.opacity = '0'; li.style.maxHeight = '0'; li.style.margin = '0'; li.style.padding = '0'; });
        setTimeout(() => li.remove(), 280);
    }, 10000);
    _agendaUndo[id] = { html, t, tick };
}
function agendaUndo(id) {
    const u = _agendaUndo[id];
    if (!u) return;
    clearTimeout(u.t); clearInterval(u.tick);
    const li = document.getElementById('agenda-li-' + id);
    if (li) li.innerHTML = u.html;
    delete _agendaUndo[id];
}

// Agenda: "prioridad de hoy" — el agente escribe un resumen corto en el chat
async function priorityToday() {
    messagesEl.querySelector('.empty-state')?.remove();
    typing.style.display = 'flex';
    scrollBottom();
    try {
        const res = await fetch(`/Classroom/${studentId}?handler=PriorityToday`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
            body: new URLSearchParams({ studentId })
        });
        typing.style.display = 'none';
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        addBubble(data.reply || data.error || 'No pude armar las prioridades.', 'assistant');
    } catch {
        typing.style.display = 'none';
        addBubble('Error al armar las prioridades. Probá de nuevo.', 'assistant');
    }
}

// Modo Foco: en Foco se ve solo Vencido/Hoy; oculta próximas + anuncios. Default ON si TDAH.
function applyFocusMode(on, btn) {
    document.body.classList.toggle('focus-mode', on);
    if (btn) btn.textContent = on ? '📋 Ver todo' : '🎯 Modo foco';
}
function toggleFocusMode(btn) {
    const on = !document.body.classList.contains('focus-mode');
    localStorage.setItem('mt_focus', on ? '1' : '0');
    applyFocusMode(on, btn);
}
(function () {
    const btn = document.getElementById('focus-toggle');
    if (!btn) return;
    const stored = localStorage.getItem('mt_focus');
    const on = stored === null ? (btn.dataset.adhd === '1') : (stored === '1');
    applyFocusMode(on, btn);
})();

async function toolbarAction(handler, label) {
    btnQuiz.disabled = btnCards.disabled = btnExam.disabled = true;
    messagesEl.querySelector('.empty-state')?.remove();
    typing.style.display = 'flex';
    scrollBottom();
    try {
        const res = await fetch(`/Classroom/${studentId}?handler=${handler}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
            body: new URLSearchParams({ studentId })
        });
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        typing.style.display = 'none';
        if (data.type === 'flashcards') {
            addFlashcards(data.cards);
        } else if (data.type === 'exam' || data.type === 'quiz') {
            openExam(data.questions, label);
        } else if (data.reply) {
            addBubble(data.reply, 'assistant');
        } else {
            addBubble('Error: ' + (data.error ?? 'sin respuesta'), 'assistant');
        }
    } catch(e) {
        typing.style.display = 'none';
        addBubble('Error de conexión. Intentá de nuevo.', 'assistant');
    } finally {
        btnQuiz.disabled = btnCards.disabled = btnExam.disabled = false;
    }
}

// Modal de tarjetas
let _cards = [], _cardIdx = 0, _showingBack = false;

function addFlashcards(cards) {
    // Burbuja en el chat con botón para abrir
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.innerHTML = `
        <div class="msg__avatar msg__avatar--assistant">${tutorAv}</div>
        <div class="msg__body">
            <span class="msg__label">${tutorLabel}</span>
            <div class="msg__bubble">
                Armé ${cards.length} tarjetas de estudio.
                <br><button class="btn-main btn-sm" style="margin-top:.5rem" onclick="openCards()">📇 Abrir tarjetas</button>
            </div>
        </div>`;
    messagesEl.insertBefore(wrap, typing);
    scrollBottom();
    _cards = cards;
    openCards();
}

function openCards() {
    if (!_cards.length) return;
    _cardIdx = 0;
    renderCard();
    document.getElementById('cards-modal').style.display = 'flex';
}

function renderCard() {
    _showingBack = false;
    const c = _cards[_cardIdx];
    document.getElementById('cards-counter').textContent = `${_cardIdx + 1} / ${_cards.length}`;
    document.getElementById('cards-text').textContent = c.front;
    document.getElementById('cards-face-label').textContent = 'Frente';
    document.getElementById('cards-card').classList.remove('showing-back');
    document.getElementById('cards-flip').textContent = 'Ver respuesta';
    document.getElementById('cards-prev').disabled = _cardIdx === 0;
    document.getElementById('cards-next').disabled = _cardIdx === _cards.length - 1;
}

document.getElementById('cards-flip').addEventListener('click', () => {
    const c = _cards[_cardIdx];
    _showingBack = !_showingBack;
    document.getElementById('cards-text').textContent = _showingBack ? c.back : c.front;
    document.getElementById('cards-face-label').textContent = _showingBack ? 'Dorso' : 'Frente';
    document.getElementById('cards-card').classList.toggle('showing-back', _showingBack);
    document.getElementById('cards-flip').textContent = _showingBack ? 'Ver pregunta' : 'Ver respuesta';
});
document.getElementById('cards-prev').addEventListener('click', () => { if (_cardIdx > 0) { _cardIdx--; renderCard(); } });
document.getElementById('cards-next').addEventListener('click', () => { if (_cardIdx < _cards.length - 1) { _cardIdx++; renderCard(); } });
document.getElementById('cards-close').addEventListener('click', () => { document.getElementById('cards-modal').style.display = 'none'; });
document.querySelector('#cards-modal .cards-modal__backdrop').addEventListener('click', () => { document.getElementById('cards-modal').style.display = 'none'; });

// Simulacro de examen
let _questions = [], _qIdx = 0, _score = 0, _answered = [];

function openExam(questions, label) {
    _questions = questions;
    _qIdx = 0; _score = 0; _answered = [];
    const title = label || 'Examen de práctica';
    renderQuestion(title);
    document.getElementById('exam-modal').style.display = 'flex';
    // Burbuja en el chat
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.innerHTML = `<div class="msg__avatar msg__avatar--assistant">${tutorAv}</div>
        <div class="msg__body"><span class="msg__label">${tutorLabel}</span>
        <div class="msg__bubble">📝 ${title} listo — ${questions.length} preguntas.
        <br><button class="btn-main btn-sm" style="margin-top:.5rem" onclick="document.getElementById('exam-modal').style.display='flex'">Retomar ${title.toLowerCase()}</button>
        </div></div>`;
    messagesEl.insertBefore(wrap, typing);
    scrollBottom();
}

function renderQuestion(title) {
    const q = _questions[_qIdx];
    const label = title || 'Examen de práctica';
    document.getElementById('exam-counter').textContent = `${label} · Pregunta ${_qIdx + 1} de ${_questions.length}`;
    document.getElementById('exam-question').textContent = q.question;
    document.getElementById('exam-result').style.display = 'none';
    const opts = document.getElementById('exam-options');
    opts.innerHTML = '';
    ['a','b','c','d'].forEach(k => {
        if (!q.options[k]) return;
        const btn = document.createElement('button');
        btn.className = 'exam-option';
        btn.innerHTML = `<strong>${k})</strong> ${q.options[k]}`;
        btn.addEventListener('click', () => selectOption(k, btn));
        opts.appendChild(btn);
    });
}

function selectOption(key, btn) {
    const q = _questions[_qIdx];
    const correct = q.correct?.toLowerCase();
    document.querySelectorAll('.exam-option').forEach(b => b.disabled = true);
    btn.classList.add(key === correct ? 'exam-option--correct' : 'exam-option--wrong');
    if (key !== correct)
        document.querySelectorAll('.exam-option').forEach(b => {
            if (b.textContent.trim().startsWith(correct + ')') || b.innerHTML.includes(`>${correct})<`)) b.classList.add('exam-option--correct');
        });
    _answered.push({ q: q.question, selected: key, correct });
    if (key === correct) _score++;

    const resultEl = document.getElementById('exam-result');
    resultEl.style.display = 'block';
    if (_qIdx < _questions.length - 1) {
        resultEl.innerHTML = `<button class="btn-main btn-sm" id="exam-next-btn">Siguiente →</button>`;
        document.getElementById('exam-next-btn').addEventListener('click', () => { _qIdx++; renderQuestion(); });
    } else {
        const pct = Math.round(_score / _questions.length * 100);
        resultEl.innerHTML = `<div class="exam-score">
            <strong>${_score}/${_questions.length} correctas (${pct}%)</strong>
            <p>${pct >= 70 ? '¡Muy bien! Estás listo/a.' : pct >= 50 ? 'Bien, pero hay conceptos para repasar.' : 'Hay bastante para repasar. ¿Arrancamos?'}</p>
            <button class="btn-main btn-sm" onclick="document.getElementById('exam-modal').style.display='none'">Cerrar</button>
        </div>`;
    }
}

document.getElementById('exam-close').addEventListener('click', () => { document.getElementById('exam-modal').style.display = 'none'; });
document.querySelector('#exam-modal .cards-modal__backdrop').addEventListener('click', () => { document.getElementById('exam-modal').style.display = 'none'; });

btnQuiz.addEventListener('click',  () => toolbarAction('Quiz',       'Quiz'));
btnCards.addEventListener('click', () => toolbarAction('Flashcards', 'Tarjetas'));
btnExam.addEventListener('click',  () => toolbarAction('Exam',       'Examen de práctica'));

// Podcast: audio-resumen de 2 hosts. Tarda ~15-30s (guión + TTS), por eso su propio flujo.
const btnPodcast = document.getElementById('btn-podcast');
if (btnPodcast) btnPodcast.addEventListener('click', generatePodcast);

async function generatePodcast() {
    btnPodcast.disabled = true;
    messagesEl.querySelector('.empty-state')?.remove();
    typing.style.display = 'flex';
    scrollBottom();
    try {
        const res = await fetch(`/Classroom/${studentId}?handler=Podcast`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
            body: new URLSearchParams({ studentId })
        });
        typing.style.display = 'none';
        if (res.status === 401) { location.href = '/Login'; return; }
        const data = await res.json();
        if (data.type === 'podcast') addPodcast(data);
        else addBubble(data.reply || data.error || 'No pude generar el podcast.', 'assistant');
    } catch {
        typing.style.display = 'none';
        addBubble('Error al generar el podcast. Probá de nuevo.', 'assistant');
    } finally {
        btnPodcast.disabled = false;
    }
}

function addPodcast(data) {
    const mins = Math.max(1, Math.round((data.durationSec || 0) / 60));
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.innerHTML = `
        <div class="msg__avatar msg__avatar--assistant">${tutorAv}</div>
        <div class="msg__body">
            <span class="msg__label">${tutorLabel}</span>
            <div class="msg__bubble">
                🎧 ${data.title} (~${mins} min)
                <audio controls preload="none" style="display:block;margin-top:.5rem;width:100%;" src="${data.url}"></audio>
            </div>
        </div>`;
    messagesEl.insertBefore(wrap, typing);
    scrollBottom();
}

// Navegación de secciones
const btnPrev = document.getElementById('btn-prev-section');
const btnNext = document.getElementById('btn-next-section');

async function advanceSection(direction) {
    const res = await fetch(`/Classroom/${studentId}?handler=AdvanceSection`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrf() },
        body: new URLSearchParams({ studentId, direction })
    });
    if (!res.ok) return;
    const data = await res.json();
    // Actualizar contador
    const counter = document.getElementById('section-counter');
    if (counter) counter.textContent = `${data.index + 1} / ${data.total}`;
    // Recargar sidebar para reflejar estado visual
    location.reload();
}

if (btnPrev) btnPrev.addEventListener('click', () => advanceSection('prev'));
if (btnNext) btnNext.addEventListener('click', () => advanceSection('next'));

async function sendMessage() {
    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = '';
    inputEl.style.height = 'auto';
    inputEl.disabled = true;
    sendBtn.disabled = true;

    // Quitar empty-state si existe
    messagesEl.querySelector('.empty-state')?.remove();

    addBubble(text, 'user');
    typing.style.display = 'flex';
    scrollBottom();

    try {
        const body = new URLSearchParams({ content: text });
        const res = await fetch(`/Classroom/${studentId}?handler=Send`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('meta[name="csrf-token"]')?.content ?? ''
            },
            body
        });

        if (res.status === 401) { location.href = '/Login'; return; }

        const data = await res.json();
        typing.style.display = 'none';

        if (data.reply) addBubble(data.reply, 'assistant');
        else addBubble('Error: ' + (data.error ?? 'sin respuesta'), 'assistant');

    } catch(e) {
        typing.style.display = 'none';
        addBubble('Error de conexión. Intentá de nuevo.', 'assistant');
    } finally {
        inputEl.disabled = false;
        sendBtn.disabled = false;
        inputEl.focus();
    }
}
</script>
