@page "/agenda/{token}"
@model miTutoria.Web.Pages.Agenda.IndexModel
@{
    Layout = "_Layout";
    var gradeTxt = string.IsNullOrEmpty(Model.GradeLabel) ? "escolar" : $"de {Model.GradeLabel}";
    var pageTitle = $"📅 Agenda {gradeTxt} — miTutorIA";
    ViewData["Title"] = pageTitle;
    var pageUrl = $"{Model.BaseUrl}/agenda/{Model.ShareToken}";
    var imageUrl = $"{Model.BaseUrl}/img/logo-wordmark.png";
    var ogDesc = "Próximas entregas, exámenes y materiales de la clase, siempre al día. Hecho con miTutorIA.";
}

@section Head {
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="miTutorIA" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:image" content="@imageUrl" />
    <meta property="og:url" content="@pageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image" content="@imageUrl" />
    <meta name="description" content="@ogDesc" />
    <style>
        .agenda-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-top:.5rem; }
        .agenda-cell { min-height:3.1rem; border:1px solid #eee; border-radius:6px; padding:.25rem; }
        @@media (max-width:480px) {
            .agenda-wrap { padding:.6rem !important; }
            .agenda-grid { gap:2px; }
            .agenda-cell { min-height:2.6rem; padding:.15rem; }
        }
    </style>
}

<section style="max-width:480px;margin:0 auto;padding:1rem;">
    <div style="text-align:center;margin-bottom:1rem;">
        <h1 style="margin:.2rem 0;font-size:1.5rem;">📅 Agenda @(string.IsNullOrEmpty(Model.GradeLabel) ? "escolar" : "de " + Model.GradeLabel)</h1>
        <p style="color:#777;margin:.2rem 0;font-size:.9rem;">Próximas entregas, exámenes y materiales de la clase.</p>
        @if (Model.LastUpdate is DateTime lu)
        {
            <span style="display:inline-block;margin-top:.3rem;background:#f1f3f1;color:#5C7A5E;font-size:.72rem;font-weight:600;padding:.25rem .6rem;border-radius:999px;"
                  title="Se sincroniza automáticamente con Classroom cada ~1 hora">
                🔄 Actualizado @lu.AddHours(-3).ToString("dd/MM HH:mm") hs
            </span>
        }
    </div>

    <section class="agenda-wrap" style="background:#fff;border:1px solid #eee;border-radius:12px;padding:1.1rem 1.2rem;box-shadow:0 2px 8px rgba(0,0,0,.04);">
        <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;">
            <a href="/agenda/@Model.ShareToken?off=@Model.CalPrevOff" title="Atrás" style="text-decoration:none;font-size:1.1rem;color:#888;">◀</a>
            <strong style="min-width:9rem;text-align:center;">@Model.CalRangeLabel</strong>
            <a href="/agenda/@Model.ShareToken?off=@Model.CalNextOff" title="Adelante" style="text-decoration:none;font-size:1.1rem;color:#888;">▶</a>
        </div>

        @if (Model.HasCalendar)
        {
            <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:.6rem 0;font-size:.78rem;color:#666;justify-content:center;">
                @foreach (var k in Model.CalLegend)
                {
                    <span style="display:inline-flex;align-items:center;gap:.3rem;">
                        <span style="width:.7rem;height:.7rem;border-radius:50%;background:@k.Color;display:inline-block;"></span>@k.Name
                    </span>
                }
                <span style="color:#ccc;">·</span>
                <span style="color:#999;">E=Examen · T=Tarea · M=Material · A=Anuncio</span>
            </div>
        }

        <div class="agenda-grid">
            @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
            {
                <div style="text-align:center;font-size:.7rem;color:#aaa;font-weight:600;">@d</div>
            }
            @foreach (var d in Model.CalDays)
            {
                var has = d.Events.Count > 0;
                <div class="agenda-cell" onclick="@(has ? $"showCalDay({d.Index})" : "")"
                     style="@(d.IsPast ? "opacity:.5;" : "")@(d.IsToday ? "border-color:#C94A1F;background:#fdf6f3;" : "")@(has ? "cursor:pointer;" : "")">
                    <div style="font-size:.72rem;font-weight:@(d.IsToday ? "700" : "400");color:@(d.IsToday ? "#C94A1F" : "#bbb");">
                        @d.DayNum@(d.MonthAbbr != null ? $" {d.MonthAbbr}" : "")
                    </div>
                    @if (has)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:2px;margin-top:2px;">
                            @foreach (var e in d.Events)
                            {
                                <span title="@e.Title (@e.CourseName)"
                                      style="width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.HasCalendar)
        {
            <div id="cal-detail" style="margin-top:.8rem;font-size:.85rem;color:#555;"></div>
            <script>
                const calData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CalDays.Where(d => d.Events.Count > 0).ToDictionary(d => d.Index, d => d.Events)));
                function showCalDay(d) {
                    const evs = calData[d] || [];
                    const el = document.getElementById('cal-detail');
                    if (!evs.length) { el.innerHTML = ''; return; }
                    el.innerHTML = '<ul style="margin:.3rem 0 0;padding-left:1rem;list-style:none;">' +
                        evs.map(e => '<li style="margin:.2rem 0;"><span style="display:inline-block;width:.6rem;height:.6rem;border-radius:50%;background:' + e.Color + ';margin-right:.4rem;"></span><strong>' + e.Letter + '</strong> ' +
                            e.Title + ' <span style="color:#999;">· ' + e.CourseName + '</span></li>').join('') + '</ul>';
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            </script>
        }
        else
        {
            <p style="margin-top:.6rem;font-size:.85rem;color:#999;text-align:center;">Sin entregas en esta ventana.</p>
        }
    </section>

    @* ── CTA: venta encubierta ── *@
    <div style="margin-top:1.2rem;border-radius:14px;padding:1.4rem 1.3rem;text-align:center;color:#fff;
                background:linear-gradient(135deg,#C94A1F 0%,#A23416 100%);
                box-shadow:0 8px 24px rgba(201,74,31,.28);">
        <span style="display:inline-block;background:rgba(255,255,255,.18);color:#fff;font-size:.7rem;font-weight:700;
                     letter-spacing:.05em;text-transform:uppercase;padding:.25rem .6rem;border-radius:999px;">⚡ Nuevo</span>
        <h2 style="margin:.6rem 0 .3rem;font-size:1.5rem;line-height:1.2;color:#fff;">
            Tu hijo estudia mejor<br><em style="font-weight:400;">con un tutor de IA</em>
        </h2>
        <p style="margin:.2rem auto .9rem;max-width:30rem;color:rgba(255,255,255,.9);font-size:.92rem;">
            miTutorIA arma esta agenda leyendo Google Classroom, y además guía a tu hijo paso a paso <strong>sin hacerle la tarea</strong>.
        </p>
        <ul style="list-style:none;padding:0;margin:0 auto 1.1rem;max-width:22rem;text-align:left;font-size:.9rem;">
            @foreach (var f in new[] { "Agenda escolar automática", "Tutor IA que explica, no resuelve", "Seguimiento para padres", "Funciona con Google Classroom" })
            {
                <li style="display:flex;align-items:center;gap:.5rem;margin:.35rem 0;">
                    <span style="flex:none;width:1.2rem;height:1.2rem;border-radius:50%;background:rgba(255,255,255,.22);display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;">✓</span>
                    @f
                </li>
            }
        </ul>
        <a href="/" style="display:inline-block;background:#fff;color:#C94A1F;font-weight:700;text-decoration:none;
                           padding:.7rem 1.5rem;border-radius:10px;box-shadow:0 4px 12px rgba(0,0,0,.15);">
            Conocé miTutorIA →
        </a>
        <p style="margin:.8rem 0 0;color:rgba(255,255,255,.8);font-size:.78rem;">Gratis para empezar · Sin tarjeta requerida</p>
    </div>
    <p style="text-align:center;color:#bbb;font-size:.75rem;margin-top:.8rem;">Lectura automática de Classroom — puede fallar. Confirmá en la app del colegio.</p>
</section>
