@page "/agenda/{token}"
@model miTutoria.Web.Pages.Agenda.IndexModel
@{
    Layout = "_Layout";
    var gradeTxt = string.IsNullOrEmpty(Model.GradeLabel) ? "escolar" : $"de {Model.GradeLabel}";
    var pageTitle = $"📅 Agenda {gradeTxt} — miTutorIA";
    ViewData["Title"] = pageTitle;
    var pageUrl = $"{Model.BaseUrl}/agenda/{Model.ShareToken}";
    var imageUrl = $"{Model.BaseUrl}/img/logo-wordmark.png";
    var ogDesc = "Próximas entregas, exámenes y materiales de la clase, siempre al día. Hecho con miTutorIA.";
}

@section Head {
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="miTutorIA" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:image" content="@imageUrl" />
    <meta property="og:url" content="@pageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image" content="@imageUrl" />
    <meta name="description" content="@ogDesc" />
    <style>
        .agenda-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-top:.5rem; }
        .agenda-cell { min-height:3.1rem; border:1px solid #eee; border-radius:6px; padding:.25rem; }
        @@media (max-width:480px) {
            .agenda-wrap { padding:.6rem !important; }
            .agenda-grid { gap:3px; font-size:.85rem; }
            .agenda-cell { min-height:3rem; padding:.2rem; }   /* tap-target ~48px */
        }
    </style>
}

<section style="max-width:480px;margin:0 auto;padding:5rem 1rem 1rem;">
    <div style="margin-bottom:1rem;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.4rem;">
            <span style="flex:1;"></span>
            <h1 style="flex:none;text-align:center;margin:.2rem 0;font-size:1.45rem;line-height:1.15;">
                📅 Agenda<br>@(string.IsNullOrEmpty(Model.GradeLabel) ? "escolar" : Model.GradeLabel)
            </h1>
            <span style="flex:1;text-align:right;font-size:.68rem;color:#999;white-space:nowrap;line-height:1.3;"
                  title="Se sincroniza con Classroom cada ~1 hora">
                @if (Model.LastUpdate is DateTime lu)
                {
                    <text>🔄 actualizado<br>@lu.AddHours(-3).ToString("dd/MM HH:mm")</text>
                }
            </span>
        </div>
        <p style="text-align:center;color:#777;margin:.3rem 0 0;font-size:.9rem;">Próximas entregas, exámenes y materiales de la clase.</p>
    </div>

    <section class="agenda-wrap" style="background:#fff;border:1px solid #eee;border-radius:12px;padding:1.1rem 1.2rem;box-shadow:0 2px 8px rgba(0,0,0,.04);">
        <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;">
            <a href="/agenda/@Model.ShareToken?off=@Model.CalPrevOff" title="Atrás" style="text-decoration:none;font-size:1.1rem;color:#888;">◀</a>
            <strong style="min-width:9rem;text-align:center;">@Model.CalRangeLabel</strong>
            <a href="/agenda/@Model.ShareToken?off=@Model.CalNextOff" title="Adelante" style="text-decoration:none;font-size:1.1rem;color:#888;">▶</a>
        </div>

        @if (Model.HasCalendar)
        {
            <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:.6rem 0;font-size:.78rem;color:#666;justify-content:center;">
                @foreach (var k in Model.CalLegend)
                {
                    <span style="display:inline-flex;align-items:center;gap:.3rem;">
                        <span style="width:.7rem;height:.7rem;border-radius:50%;background:@k.Color;display:inline-block;"></span>@k.Name
                    </span>
                }
                <span style="color:#ccc;">·</span>
                <span style="color:#999;">E=Examen · T=Tarea · M=Material · A=Anuncio</span>
            </div>
        }

        <div class="agenda-grid">
            @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
            {
                <div style="text-align:center;font-size:.7rem;color:#aaa;font-weight:600;">@d</div>
            }
            @foreach (var d in Model.CalDays)
            {
                var has = d.Events.Count > 0;
                <div class="agenda-cell"
                     style="@(d.IsPast ? "opacity:.5;" : "")@(d.IsToday ? "border-color:#C94A1F;background:#fdf6f3;" : "")">
                    <div style="font-size:.72rem;font-weight:@(d.IsToday ? "700" : "400");color:@(d.IsToday ? "#C94A1F" : "#bbb");">
                        @d.DayNum@(d.MonthAbbr != null ? $" {d.MonthAbbr}" : "")
                    </div>
                    @if (has)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:2px;margin-top:2px;">
                            @foreach (var e in d.Events)
                            {
                                <span title="@e.Title (@e.CourseName)"
                                      style="width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Lista siempre visible (en mobile no hay hover): nombre + materia de cada entrega. *@
        @if (Model.HasCalendar || Model.UndatedUpcoming.Any())
        {
            <div style="margin-top:1rem;border-top:1px solid #eee;padding-top:.8rem;font-size:.85rem;color:#555;">
                @foreach (var day in Model.CalDays.Where(d => d.Events.Count > 0))
                {
                    <div style="margin:.5rem 0;">
                        <div style="font-weight:700;color:#444;">@day.DayNum@(day.MonthAbbr != null ? $" {day.MonthAbbr}" : "")@(day.IsToday ? " · hoy" : "")</div>
                        @foreach (var e in day.Events)
                        {
                            <div style="display:flex;align-items:center;gap:.45rem;margin:.25rem 0 .25rem .3rem;">
                                <span style="flex:none;width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                                <span>@e.Title <span style="color:#999;">· @e.CourseName</span></span>
                            </div>
                        }
                    </div>
                }
                @if (Model.UndatedUpcoming.Any())
                {
                    <div style="margin-top:.6rem;">
                        <div style="font-weight:700;color:#444;">📌 Sin fecha definida</div>
                        @foreach (var e in Model.UndatedUpcoming)
                        {
                            <div style="display:flex;align-items:center;gap:.45rem;margin:.25rem 0 .25rem .3rem;">
                                <span style="flex:none;width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                                <span>@e.Title <span style="color:#999;">· @e.CourseName</span></span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p style="margin-top:.6rem;font-size:.85rem;color:#999;text-align:center;">Sin entregas en esta ventana.</p>
        }
    </section>

    @* ── CTA: venta encubierta (paleta de marca, jerarquía sutil) ── *@
    <div style="margin-top:1.2rem;border-radius:12px;padding:1.4rem 1.3rem;text-align:center;
                background:#faf9f7;border:1px solid #ece8e3;border-left:3px solid #C94A1F;
                box-shadow:0 2px 12px rgba(0,0,0,.05);">
        <span style="display:inline-block;background:#fdf0ec;color:#C94A1F;font-size:.7rem;font-weight:700;
                     letter-spacing:.05em;text-transform:uppercase;padding:.25rem .6rem;border-radius:999px;">⚡ Nuevo</span>
        <h2 style="margin:.6rem 0 .3rem;font-family:'Playfair Display',Georgia,serif;font-size:1.6rem;line-height:1.2;color:#1a1a1a;">
            Tu hijo estudia mejor<br><em style="font-weight:400;">con un tutor de IA</em>
        </h2>
        <p style="margin:.2rem auto .9rem;max-width:30rem;color:#666;font-size:.92rem;">
            Lo guía paso a paso para que aprenda de verdad — <strong>sin hacerle la tarea</strong>.
        </p>
        <ul style="list-style:none;padding:0;margin:0 auto 1.1rem;max-width:22rem;text-align:left;font-size:.9rem;color:#444;">
            @foreach (var f in new[] { "Agenda escolar automática *", "Tutor que explica, no resuelve", "Seguimiento para padres" })
            {
                <li style="display:flex;align-items:center;gap:.5rem;margin:.35rem 0;">
                    <span style="flex:none;width:1.2rem;height:1.2rem;border-radius:50%;background:#e9efe9;color:#5C7A5E;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;">✓</span>
                    @f
                </li>
            }
        </ul>
        <a href="/agenda/@Model.ShareToken/ir" style="display:inline-block;background:#C94A1F;color:#fff;font-weight:700;text-decoration:none;
                           padding:.7rem 1.6rem;border-radius:10px;box-shadow:0 4px 12px rgba(201,74,31,.25);">
            Conocé miTutorIA →
        </a>
        <p style="margin:.8rem 0 0;color:#999;font-size:.78rem;">Gratis para empezar · Sin tarjeta requerida</p>
    </div>
    <p style="text-align:center;color:#aaa;font-size:.74rem;margin-top:.7rem;line-height:1.4;">
        * La agenda se arma desde Google Classroom, según la disponibilidad de tu colegio. Lectura automática — puede fallar; confirmá en la app del colegio.
    </p>
</section>
