@page "/agenda/{token}"
@model miTutoria.Web.Pages.Agenda.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Agenda escolar";
}

<section style="max-width:760px;margin:0 auto;padding:1rem;">
    <div style="text-align:center;margin-bottom:1rem;">
        <h1 style="margin:.2rem 0;">📅 Agenda escolar</h1>
        <p style="color:#777;margin:.2rem 0;">Próximas entregas, exámenes y materiales de la clase.</p>
    </div>

    <section style="background:#fff;border:1px solid #eee;border-radius:8px;padding:1.1rem 1.2rem;">
        <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;">
            <a href="/agenda/@Model.ShareToken?off=@Model.CalPrevOff" title="Atrás" style="text-decoration:none;font-size:1.1rem;color:#888;">◀</a>
            <strong style="min-width:9rem;text-align:center;">@Model.CalRangeLabel</strong>
            <a href="/agenda/@Model.ShareToken?off=@Model.CalNextOff" title="Adelante" style="text-decoration:none;font-size:1.1rem;color:#888;">▶</a>
        </div>

        @if (Model.HasCalendar)
        {
            <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:.6rem 0;font-size:.78rem;color:#666;justify-content:center;">
                @foreach (var k in Model.CalLegend)
                {
                    <span style="display:inline-flex;align-items:center;gap:.3rem;">
                        <span style="width:.7rem;height:.7rem;border-radius:50%;background:@k.Color;display:inline-block;"></span>@k.Name
                    </span>
                }
                <span style="color:#ccc;">·</span>
                <span style="color:#999;">E=Examen · T=Tarea · M=Material · A=Anuncio</span>
            </div>
        }

        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:.5rem;">
            @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
            {
                <div style="text-align:center;font-size:.7rem;color:#aaa;font-weight:600;">@d</div>
            }
            @foreach (var d in Model.CalDays)
            {
                var has = d.Events.Count > 0;
                <div onclick="@(has ? $"showCalDay({d.Index})" : "")"
                     style="min-height:3.1rem;border:1px solid #eee;border-radius:6px;padding:.25rem;@(d.IsPast ? "opacity:.5;" : "")@(d.IsToday ? "border-color:#C94A1F;background:#fdf6f3;" : "")@(has ? "cursor:pointer;" : "")">
                    <div style="font-size:.72rem;font-weight:@(d.IsToday ? "700" : "400");color:@(d.IsToday ? "#C94A1F" : "#bbb");">
                        @d.DayNum@(d.MonthAbbr != null ? $" {d.MonthAbbr}" : "")
                    </div>
                    @if (has)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:2px;margin-top:2px;">
                            @foreach (var e in d.Events)
                            {
                                <span title="@e.Title (@e.CourseName)"
                                      style="width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.HasCalendar)
        {
            <div id="cal-detail" style="margin-top:.8rem;font-size:.85rem;color:#555;"></div>
            <script>
                const calData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CalDays.Where(d => d.Events.Count > 0).ToDictionary(d => d.Index, d => d.Events)));
                function showCalDay(d) {
                    const evs = calData[d] || [];
                    const el = document.getElementById('cal-detail');
                    if (!evs.length) { el.innerHTML = ''; return; }
                    el.innerHTML = '<ul style="margin:.3rem 0 0;padding-left:1rem;list-style:none;">' +
                        evs.map(e => '<li style="margin:.2rem 0;"><span style="display:inline-block;width:.6rem;height:.6rem;border-radius:50%;background:' + e.Color + ';margin-right:.4rem;"></span><strong>' + e.Letter + '</strong> ' +
                            e.Title + ' <span style="color:#999;">· ' + e.CourseName + '</span></li>').join('') + '</ul>';
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            </script>
        }
        else
        {
            <p style="margin-top:.6rem;font-size:.85rem;color:#999;text-align:center;">Sin entregas en esta ventana.</p>
        }
    </section>

    @* ── CTA: venta encubierta ── *@
    <div style="margin-top:1.2rem;background:#fdf6f3;border:1px solid #f0dcd3;border-radius:8px;padding:1.1rem 1.2rem;text-align:center;">
        <p style="margin:.2rem 0;font-weight:600;">Esta agenda la arma sola miTutorIA leyendo Google Classroom.</p>
        <p style="margin:.2rem 0 .8rem;color:#777;font-size:.9rem;">Además, tu hijo estudia con un tutor con IA que lo guía sin hacerle la tarea.</p>
        <a href="/" class="btn-main" style="text-decoration:none;">Conocé miTutorIA</a>
    </div>
    <p style="text-align:center;color:#bbb;font-size:.75rem;margin-top:.8rem;">Lectura automática de Classroom — puede fallar. Confirmá en la app del colegio.</p>
</section>
