@page "/Dashboard"
@model miTutoria.Web.Pages.Dashboard.IndexModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";

    var colors = new[] { "#C94A1F", "#5C7A5E", "#A89880", "#4A7CA0", "#8A6A9A" };

    var labels = Enumerable.Range(1, Model.DaysInMonth).Select(d => d.ToString()).ToArray();

    var datasets = Model.UsageByStudent.Select((u, i) => new {
        label = u.Name,
        data = Enumerable.Range(1, Model.DaysInMonth)
                         .Select(d => u.TokensByDay.TryGetValue(d, out var v) ? v : 0)
                         .ToArray(),
        backgroundColor = colors[i % colors.Length] + "99",
        borderColor = colors[i % colors.Length],
        borderWidth = 1,
        borderRadius = 2
    }).ToArray();

    var chartJson = JsonSerializer.Serialize(new { labels, datasets });
}

<main class="page-main">
    <div class="dashboard-header">
        <h1>Hola, @Model.FamilyName</h1>
        <div class="dashboard-nav-links">
            <a href="/Profile">Editar perfil</a>
        </div>
    </div>

    @* — Consumo del mes — *@
    <section style="margin-bottom: 2rem;">
        <div class="section-header">
            <h2>Consumo este mes</h2>
        </div>

        <div class="usage-summary">
            <div class="usage-card">
                <span class="usage-card__label">Tokens totales</span>
                <span class="usage-card__value">@Model.TotalTokensMonth.ToString("N0")</span>
            </div>
            <div class="usage-card">
                <span class="usage-card__label">Costo estimado</span>
                <span class="usage-card__value">U$D @Model.TotalCostMonth.ToString("F4")</span>
            </div>
            @foreach (var u in Model.UsageByStudent)
            {
                <div class="usage-card">
                    <span class="usage-card__label">@u.Name</span>
                    <span class="usage-card__value">@u.TotalTokens.ToString("N0") tok</span>
                    <span class="usage-card__sub">U$D @u.TotalCostUsd.ToString("F4")</span>
                </div>
            }
        </div>

        @if (Model.UsageByStudent.Count > 0)
        {
            <div class="chart-container">
                <canvas id="usageChart"></canvas>
            </div>
        }
        else
        {
            <p class="empty-state" style="margin-top:1rem;">Sin actividad este mes todavía.</p>
        }
    </section>

    @* — Hijos — *@
    <section>
        <div class="section-header">
            <h2>Hijos</h2>
            <a href="/Students/Add" class="btn-main" style="padding: 0.6rem 1.4rem; font-size: 0.85rem;">+ Agregar hijo</a>
        </div>

        @if (Model.Students.Count == 0)
        {
            <p class="empty-state">Todavía no hay estudiantes en tu familia.</p>
        }
        else
        {
            <ul class="students-list">
                @foreach (var student in Model.Students)
                {
                    <li>
                        <strong>@(student.Nickname ?? student.FullName)</strong>
                        <a href="/Classroom/@student.Id" class="btn-main" style="padding: 0.5rem 1.2rem; font-size: 0.85rem;">Abrir aula</a>
                    </li>
                }
            </ul>
        }
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const data = @Html.Raw(chartJson);
    new Chart(document.getElementById('usageChart'), {
        type: 'bar',
        data: data,
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toLocaleString()} tokens`
                    }
                }
            },
            scales: {
                x: { stacked: false, grid: { display: false } },
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });
</script>
