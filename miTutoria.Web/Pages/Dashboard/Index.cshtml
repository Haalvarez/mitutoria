@page "/Dashboard"
@model miTutoria.Web.Pages.Dashboard.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";

    string LastSeenText(DateTime? last)
    {
        if (last is null) return "Sin actividad aún";
        var diff = DateTime.UtcNow - last.Value;
        if (diff.TotalMinutes < 60)  return "Hace un rato";
        if (diff.TotalHours   < 24)  return "Hoy";
        if (diff.TotalDays    < 2)   return "Ayer";
        if (diff.TotalDays    < 7)   return $"Hace {(int)diff.TotalDays} días";
        return $"Hace más de una semana";
    }

    string ExchangeWord(int n) => n == 1 ? "intercambio" : "intercambios";
}

<main class="page-main page-main--wide">

    <div class="dashboard-header">
        <div>
            <h1>Hola, @Model.FamilyName</h1>
            <p class="dashboard-subtitle">Así va el aprendizaje de tu familia este mes.</p>
        </div>
        <a href="/Profile" class="btn-secondary">Editar perfil</a>
    </div>

    @* ── Mensaje de enganche ── *@
    @{
        var topStreak = Model.StudentSummaries.OrderByDescending(s => s.StreakDays).FirstOrDefault();
        var studiedTodayCount = Model.StudentSummaries.Count(s => s.ExchangesToday > 0);
    }
    @if (topStreak is { StreakDays: >= 3 })
    {
        <div class="dashboard-highlight" style="background:#f3f6f1;border-left:3px solid #5C7A5E;padding:.8rem 1.1rem;border-radius:6px;margin-bottom:1.5rem;font-size:.95rem;">
            🔥 <strong>@topStreak.Name</strong> lleva <strong>@topStreak.StreakDays días seguidos</strong> estudiando — el hábito se está formando.
        </div>
    }
    else if (studiedTodayCount > 0)
    {
        <div class="dashboard-highlight" style="background:#f3f6f1;border-left:3px solid #5C7A5E;padding:.8rem 1.1rem;border-radius:6px;margin-bottom:1.5rem;font-size:.95rem;">
            ✨ @(studiedTodayCount == 1 ? "Uno de tus hijos ya estudió hoy" : $"{studiedTodayCount} de tus hijos ya estudiaron hoy"). ¡Buen comienzo!
        </div>
    }

    @* ── Estado de suscripción ── *@
    @{
        var (subLabel, subColor) = Model.SubscriptionStatus switch
        {
            "trial"  => ("Período de prueba", "#5C7A5E"),
            "active" => ("Suscripción activa", "#5C7A5E"),
            _        => ("Cuenta", "#888")
        };
        string remainingText;
        var warnExpiry = false;
        if (Model.AccessEndsAt is null) { remainingText = ""; }
        else if (Model.DaysRemaining <= 0) { remainingText = "Vence hoy"; warnExpiry = true; }
        else if (Model.SubscriptionStatus == "active") { remainingText = $"Se renueva en {Model.DaysRemaining} {(Model.DaysRemaining == 1 ? "día" : "días")}"; warnExpiry = Model.DaysRemaining <= 3; }
        else { remainingText = $"Te quedan {Model.DaysRemaining} {(Model.DaysRemaining == 1 ? "día" : "días")}"; warnExpiry = Model.DaysRemaining <= 3; }
    }
    <section class="subscription-bar" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;background:#fff;border:1px solid #eee;border-radius:8px;padding:1rem 1.2rem;margin-bottom:1.5rem;">
        <div>
            <span style="display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:@subColor;">@subLabel</span>
            @if (!string.IsNullOrEmpty(remainingText))
            {
                <div style="font-size:.9rem;margin-top:.15rem;color:@(warnExpiry ? "#C94A1F" : "#555");font-weight:@(warnExpiry ? "600" : "400");">
                    @remainingText
                    @if (Model.AccessEndsAt is not null)
                    {
                        <span style="color:#aaa;font-weight:400;"> · hasta el @Model.AccessEndsAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    }
                </div>
            }
        </div>
        @* El pago se habilita al activar el cobro (MercadoPago). El botón generará el link por familia. *@
        <button type="button" class="btn-main" disabled
                title="Disponible pronto — vas a poder pagar tu suscripción desde acá"
                style="opacity:.45;cursor:not-allowed;">
            Quiero pagar
        </button>
    </section>

    @* ── Hijos ── *@
    <section class="dashboard-section">
        <div class="section-header">
            <h2>Tus hijos</h2>
            <a href="/Students/Add" class="btn-main btn-sm">+ Agregar</a>
        </div>

        @if (Model.Students.Count == 0)
        {
            <div class="empty-card">
                <p>Todavía no agregaste ningún hijo.</p>
                <a href="/Students/Add" class="btn-main" style="margin-top:0.8rem; display:inline-block;">Agregar el primero</a>
            </div>
        }
        else
        {
            <div class="student-cards">
                @foreach (var s in Model.StudentSummaries)
                {
                    var studiedToday = s.ExchangesToday > 0;
                    <div class="student-card @(studiedToday ? "student-card--active" : "")">
                        <div class="student-card__top">
                            <div class="student-card__avatar">@s.Name[0].ToString().ToUpper()</div>
                            <div class="student-card__info">
                                <strong class="student-card__name">@s.Name</strong>
                                <span class="student-card__last">@LastSeenText(s.LastActivity)</span>
                            </div>
                            @if (s.StreakDays >= 2)
                            {
                                <span class="badge-streak" title="@s.StreakDays días seguidos estudiando">🔥 @s.StreakDays</span>
                            }
                            else if (studiedToday)
                            {
                                <span class="badge-today">Estudió hoy</span>
                            }
                        </div>

                        <div class="student-card__stats">
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesToday</span>
                                <span class="stat__label">hoy</span>
                            </div>
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesThisWeek</span>
                                <span class="stat__label">esta semana</span>
                            </div>
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesThisMonth</span>
                                <span class="stat__label">este mes</span>
                            </div>
                        </div>
                        <p class="stat__hint">@ExchangeWord(s.ExchangesThisMonth) con el tutor</p>

                        @if (s.Last15Days.Sum() > 0)
                        {
                            var max15 = s.Last15Days.Max();
                            <div>
                                <div class="sparkline" title="Actividad de los últimos 15 días">
                                    @foreach (var c in s.Last15Days)
                                    {
                                        var pct = max15 > 0 ? (int)Math.Round(c * 100.0 / max15) : 0;
                                        <span class="spark-bar @(c == 0 ? "spark-bar--empty" : "")"
                                              style="height:@(c == 0 ? 12 : Math.Max(pct, 25))%"></span>
                                    }
                                </div>
                                <div class="sparkline-caption">últimos 15 días</div>
                            </div>
                        }

                        <div class="student-card__actions">
                            <a href="/Students/Edit/@s.Id" class="btn-secondary btn-sm">Editar</a>
                            <a href="/Classroom/@s.Id" class="btn-main btn-sm">Abrir aula</a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ── Actividad del mes ── *@
    @if (Model.StudentSummaries.Any(s => s.ExchangesThisMonth > 0))
    {
        <section class="dashboard-section">
            <div class="section-header">
                <h2>Actividad del mes</h2>
                <span class="section-meta">intercambios por día</span>
            </div>

            <div class="usage-summary">
                <div class="usage-card">
                    <span class="usage-card__label">Intercambios totales</span>
                    <span class="usage-card__value">@Model.TotalExchangesMonth.ToString("N0")</span>
                </div>
                <div class="usage-card">
                    <span class="usage-card__label">Días activos este mes</span>
                    <span class="usage-card__value">@Model.ActiveDaysThisMonth</span>
                    <span class="usage-card__sub">de @Model.DaysInMonth días</span>
                </div>
                <div class="usage-card">
                    <span class="usage-card__label">Materiales cargados</span>
                    <span class="usage-card__value">@Model.MaterialsCount</span>
                    <span class="usage-card__sub">@(Model.MaterialsCount == 1 ? "materia con material" : "materias con material")</span>
                </div>
            </div>

            <div class="chart-container">
                <canvas id="usageChart"></canvas>
            </div>
        </section>
    }
    else
    {
        <section class="dashboard-section">
            <p class="empty-state">
                Cuando @(Model.Students.Count == 1 ? "tu hijo" : "tus hijos") empiecen a usar el aula, acá vas a ver cuánto estudiaron cada día.
            </p>
        </section>
    }

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@if (Model.StudentSummaries.Any(s => s.ExchangesThisMonth > 0))
{
    <script>
    new Chart(document.getElementById('usageChart'), {
        type: 'bar',
        data: @Html.Raw(Model.ChartJson),
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y} intercambio${ctx.parsed.y !== 1 ? 's' : ''}`
                    }
                }
            },
            scales: {
                x: { stacked: false, grid: { display: false } },
                y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'intercambios' } }
            }
        }
    });
    </script>
}
