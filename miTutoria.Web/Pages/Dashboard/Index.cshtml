@page "/Dashboard"
@model miTutoria.Web.Pages.Dashboard.IndexModel
@using miTutoria.Web.Inbox
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";

    string LastSeenText(DateTime? last)
    {
        if (last is null) return "Sin actividad aún";
        var diff = DateTime.UtcNow - last.Value;
        if (diff.TotalMinutes < 60)  return "Hace un rato";
        if (diff.TotalHours   < 24)  return "Hoy";
        if (diff.TotalDays    < 2)   return "Ayer";
        if (diff.TotalDays    < 7)   return $"Hace {(int)diff.TotalDays} días";
        return $"Hace más de una semana";
    }

    string ExchangeWord(int n) => n == 1 ? "intercambio" : "intercambios";
}

<main class="page-main page-main--wide">

    <div class="dashboard-header">
        <div>
            <h1>Hola, @Model.FamilyName</h1>
            <p class="dashboard-subtitle">Así va el aprendizaje de tu familia este mes.</p>
        </div>
        <a href="/Profile" class="btn-secondary">Editar perfil</a>
    </div>

    @* ── Mensaje de enganche ── *@
    @{
        var topStreak = Model.StudentSummaries.OrderByDescending(s => s.StreakDays).FirstOrDefault();
        var studiedTodayCount = Model.StudentSummaries.Count(s => s.ExchangesToday > 0);
    }
    @if (topStreak is { StreakDays: >= 3 })
    {
        <div class="dashboard-highlight" style="background:#f3f6f1;border-left:3px solid #5C7A5E;padding:.8rem 1.1rem;border-radius:6px;margin-bottom:1.5rem;font-size:.95rem;">
            🔥 <strong>@topStreak.Name</strong> lleva <strong>@topStreak.StreakDays días seguidos</strong> estudiando — el hábito se está formando.
        </div>
    }
    else if (studiedTodayCount > 0)
    {
        <div class="dashboard-highlight" style="background:#f3f6f1;border-left:3px solid #5C7A5E;padding:.8rem 1.1rem;border-radius:6px;margin-bottom:1.5rem;font-size:.95rem;">
            ✨ @(studiedTodayCount == 1 ? "Uno de tus hijos ya estudió hoy" : $"{studiedTodayCount} de tus hijos ya estudiaron hoy"). ¡Buen comienzo!
        </div>
    }

    @* ── Calendario mensual del aula (Track 2, gateado) ── *@
    @if (Model.InboxEnabled)
    {
        <section class="dash-calendar" style="background:#fff;border:1px solid #eee;border-radius:8px;padding:1.1rem 1.2rem;margin-bottom:1.5rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                <h2 class="dash-calendar__title" style="margin:0;">📅 Calendario del aula</h2>
                <div style="display:flex;align-items:center;gap:.8rem;">
                    <a href="?off=@Model.CalPrevOff" title="Atrás" style="text-decoration:none;font-size:1.1rem;color:#888;">◀</a>
                    <strong style="min-width:9rem;text-align:center;">@Model.CalRangeLabel</strong>
                    <a href="?off=@Model.CalNextOff" title="Adelante" style="text-decoration:none;font-size:1.1rem;color:#888;">▶</a>
                </div>
            </div>

            @{
                var hasAny = Model.HasCalendar || Model.UndatedUpcoming.Any();
                var multiKid = Model.CalLegend.Count > 1;
            }

            @if (hasAny)
            {
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin:.6rem 0;font-size:.78rem;color:#666;align-items:center;">
                    @if (multiKid) { <span style="color:#999;">Filtrar:</span> }
                    @foreach (var k in Model.CalLegend)
                    {
                        <button type="button" onclick="toggleKid(@k.Id, this)"
                                style="display:inline-flex;align-items:center;gap:.3rem;background:none;border:1px solid #eee;border-radius:999px;padding:.15rem .55rem;cursor:pointer;font-size:.78rem;color:#555;">
                            <span style="width:.7rem;height:.7rem;border-radius:50%;background:@k.Color;display:inline-block;"></span>@k.Name
                        </button>
                    }
                    <span style="color:#ccc;">·</span>
                    <span style="color:#999;">E=Examen · T=Tarea · M=Material · A=Anuncio</span>
                </div>
            }

            <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:.5rem;">
                @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
                {
                    <div style="text-align:center;font-size:.7rem;color:#aaa;font-weight:600;">@d</div>
                }
                @foreach (var d in Model.CalDays)
                {
                    <div style="min-height:3.1rem;border:1px solid #eee;border-radius:6px;padding:.25rem;@(d.IsPast ? "opacity:.5;" : "")@(d.IsToday ? "border-color:#C94A1F;background:#fdf6f3;" : "")">
                        <div style="font-size:.72rem;font-weight:@(d.IsToday ? "700" : "400");color:@(d.IsToday ? "#C94A1F" : "#bbb");">
                            @d.DayNum@(d.MonthAbbr != null ? $" {d.MonthAbbr}" : "")
                        </div>
                        @if (d.Events.Count > 0)
                        {
                            <div style="display:flex;flex-wrap:wrap;gap:2px;margin-top:2px;">
                                @foreach (var e in d.Events)
                                {
                                    <span data-student="@e.StudentId" title="@e.Title (@e.CourseName · @e.StudentName)"
                                          style="width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (hasAny)
            {
                <div style="margin-top:1rem;border-top:1px solid #eee;padding-top:.8rem;font-size:.85rem;color:#555;">
                    @foreach (var day in Model.CalDays.Where(d => d.Events.Count > 0))
                    {
                        <div style="margin:.5rem 0;">
                            <div style="font-weight:700;color:#444;">@day.DayNum@(day.MonthAbbr != null ? $" {day.MonthAbbr}" : "")@(day.IsToday ? " · hoy" : "")</div>
                            @foreach (var e in day.Events)
                            {
                                <div data-student="@e.StudentId" style="display:flex;align-items:center;gap:.45rem;margin:.25rem 0 .25rem .3rem;">
                                    <span style="flex:none;width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                                    <span>@e.Title <span style="color:#999;">· @e.CourseName · @e.StudentName</span></span>
                                </div>
                            }
                        </div>
                    }
                    @if (Model.UndatedUpcoming.Any())
                    {
                        <div style="margin-top:.6rem;">
                            <div style="font-weight:700;color:#444;">📌 Sin fecha definida</div>
                            @foreach (var e in Model.UndatedUpcoming)
                            {
                                <div data-student="@e.StudentId" style="display:flex;align-items:center;gap:.45rem;margin:.25rem 0 .25rem .3rem;">
                                    <span style="flex:none;width:1.1rem;height:1.1rem;border-radius:50%;background:@e.Color;color:#fff;font-size:.62rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;">@e.Letter</span>
                                    <span>@e.Title <span style="color:#999;">· @e.CourseName · @e.StudentName</span></span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <script>
                    const activeKids = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CalLegend.Select(k => k.Id))));
                    function toggleKid(id, el) {
                        if (activeKids.has(id)) { activeKids.delete(id); el.style.opacity = '.4'; }
                        else { activeKids.add(id); el.style.opacity = '1'; }
                        document.querySelectorAll('[data-student]').forEach(n => {
                            const sid = parseInt(n.getAttribute('data-student'), 10);
                            n.style.display = activeKids.has(sid) ? '' : 'none';
                        });
                    }
                </script>
            }
            else
            {
                <p class="dim" style="margin-top:.6rem;font-size:.85rem;">Sin entregas en esta ventana.</p>
            }
            <p class="dash-calendar__note" style="margin-top:.6rem;">Lectura automática de Classroom — puede fallar. Confirmá en la app del colegio.</p>
        </section>
    }

    @* ── Estado de suscripción ── *@
    @{
        var (subLabel, subColor) = Model.SubscriptionStatus switch
        {
            "trial"  => ("Período de prueba", "#5C7A5E"),
            "active" => ("Suscripción activa", "#5C7A5E"),
            _        => ("Cuenta", "#888")
        };
        string remainingText;
        var warnExpiry = false;
        if (Model.AccessEndsAt is null) { remainingText = ""; }
        else if (Model.DaysRemaining <= 0) { remainingText = "Vence hoy"; warnExpiry = true; }
        else if (Model.SubscriptionStatus == "active") { remainingText = $"Se renueva en {Model.DaysRemaining} {(Model.DaysRemaining == 1 ? "día" : "días")}"; warnExpiry = Model.DaysRemaining <= 3; }
        else { remainingText = $"Te quedan {Model.DaysRemaining} {(Model.DaysRemaining == 1 ? "día" : "días")}"; warnExpiry = Model.DaysRemaining <= 3; }
    }
    <section class="subscription-bar" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;background:#fff;border:1px solid #eee;border-radius:8px;padding:1rem 1.2rem;margin-bottom:1.5rem;">
        <div>
            <span style="display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:@subColor;">@subLabel</span>
            @if (!string.IsNullOrEmpty(remainingText))
            {
                <div style="font-size:.9rem;margin-top:.15rem;color:@(warnExpiry ? "#C94A1F" : "#555");font-weight:@(warnExpiry ? "600" : "400");">
                    @remainingText
                    @if (Model.AccessEndsAt is not null)
                    {
                        <span style="color:#aaa;font-weight:400;"> · hasta el @Model.AccessEndsAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    }
                </div>
            }
        </div>
        @* El pago se habilita al activar el cobro (MercadoPago). El link/QR se genera por familia. *@
        @if (Model.MpEnabled)
        {
            <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;">
                <input type="text" id="promoCode" placeholder="¿Tenés un cupón?"
                       style="padding:.5rem .7rem;border:1px solid #ddd;border-radius:6px;font-size:.85rem;text-transform:uppercase;width:9rem;" />
                <a href="/api/pay/start" class="btn-main" style="text-decoration:none;"
                   onclick="return goPay(this, '/api/pay/start');">Quiero pagar</a>
                <a href="/api/pay/email" style="font-size:.85rem;color:#4A7CA0;text-decoration:none;"
                   title="Te mandamos el link de pago al correo registrado"
                   onclick="return goPay(this, '/api/pay/email');">Enviármelo al correo</a>
            </div>
            <script>
                function goPay(el, base) {
                    var c = (document.getElementById('promoCode')?.value || '').trim();
                    window.location.href = base + (c ? ('?code=' + encodeURIComponent(c)) : '');
                    return false;
                }
            </script>
        }
        else
        {
            <button type="button" class="btn-main" disabled
                    title="Disponible pronto — vas a poder pagar tu suscripción desde acá"
                    style="opacity:.45;cursor:not-allowed;">
                Quiero pagar
            </button>
        }
    </section>

    @* Feedback del retorno de MercadoPago *@
    @if (!string.IsNullOrEmpty(Model.PagoResult))
    {
        var (pagoMsg, pagoColor) = Model.PagoResult switch
        {
            "ok"        => ("¡Listo! Recibimos tu pago. Tu suscripción se renovó.", "#5C7A5E"),
            "mail"      => ("Te enviamos el link de pago a tu correo registrado.", "#4A7CA0"),
            "pendiente" => ("Tu pago quedó pendiente de acreditación. Te avisamos cuando se confirme.", "#A8862F"),
            "promo"     => ("El cupón no es válido o está vencido. Revisá la clave e intentá de nuevo.", "#C94A1F"),
            _           => ("No pudimos procesar el pago. Probá de nuevo en un momento.", "#C94A1F")
        };
        <div style="background:#fff;border:1px solid @pagoColor;border-left:4px solid @pagoColor;border-radius:8px;padding:.8rem 1rem;margin-bottom:1.5rem;color:@pagoColor;font-size:.9rem;">
            @pagoMsg
        </div>
    }

    @* ── Hijos ── *@
    <section class="dashboard-section">
        <div class="section-header">
            <h2>Tus hijos</h2>
            <a href="/Students/Add" class="btn-main btn-sm">+ Agregar</a>
        </div>

        @if (Model.Students.Count == 0)
        {
            <div class="empty-card">
                <p>Todavía no agregaste ningún hijo.</p>
                <a href="/Students/Add" class="btn-main" style="margin-top:0.8rem; display:inline-block;">Agregar el primero</a>
            </div>
        }
        else
        {
            <div class="student-cards">
                @foreach (var s in Model.StudentSummaries)
                {
                    var studiedToday = s.ExchangesToday > 0;
                    <div class="student-card @(studiedToday ? "student-card--active" : "")">
                        <div class="student-card__top">
                            <div class="student-card__avatar">@(string.IsNullOrEmpty(s.Avatar) ? s.Name[0].ToString().ToUpper() : s.Avatar)</div>
                            <div class="student-card__info">
                                <strong class="student-card__name">@s.Name</strong>
                                <span class="student-card__last">@LastSeenText(s.LastActivity)</span>
                            </div>
                            @if (s.StreakDays >= 2)
                            {
                                <span class="badge-streak" title="@s.StreakDays días seguidos estudiando">🔥 @s.StreakDays</span>
                            }
                            else if (studiedToday)
                            {
                                <span class="badge-today">Estudió hoy</span>
                            }
                        </div>

                        <div class="student-card__stats">
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesToday</span>
                                <span class="stat__label">hoy</span>
                            </div>
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesThisWeek</span>
                                <span class="stat__label">esta semana</span>
                            </div>
                            <div class="stat">
                                <span class="stat__value">@s.ExchangesThisMonth</span>
                                <span class="stat__label">este mes</span>
                            </div>
                        </div>
                        <p class="stat__hint">@ExchangeWord(s.ExchangesThisMonth) con el tutor</p>

                        @if (Model.AttentionEnabled && s.HasAttentionToday)
                        {
                            var (focoColor, focoLabel) = s.AttentionPct switch
                            {
                                >= 80 => ("#5C7A5E", "alta"),
                                >= 50 => ("#A8862F", "media"),
                                _     => ("#C94A1F", "baja")
                            };
                            <div class="attention-box" style="margin-top:.6rem;padding:.6rem .7rem;background:#faf9f7;border:1px solid #eee;border-radius:8px;">
                                <div style="display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;">
                                    <span style="font-size:.72rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:#888;">Concentración hoy</span>
                                    <span style="font-size:.78rem;font-weight:600;color:@focoColor;">@focoLabel · @s.AttentionPct%</span>
                                </div>
                                <div style="height:6px;border-radius:4px;background:#eee;margin:.4rem 0;overflow:hidden;">
                                    <div style="height:100%;width:@(s.AttentionPct)%;background:@focoColor;"></div>
                                </div>
                                <div style="display:flex;justify-content:space-between;font-size:.78rem;color:#666;">
                                    <span>🎯 @s.FocusedMinutesToday min concentrado@(s.FocusedMinutesToday == 1 ? "" : "s")</span>
                                    @if (s.InterruptionsToday > 0)
                                    {
                                        <span title="Veces que dejó la pestaña de miTutorIA">↪ se fue @s.InterruptionsToday @(s.InterruptionsToday == 1 ? "vez" : "veces")</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (s.Last15Days.Sum() > 0)
                        {
                            var max15 = s.Last15Days.Max();
                            <div>
                                <div class="sparkline" title="Actividad de los últimos 15 días">
                                    @foreach (var c in s.Last15Days)
                                    {
                                        var pct = max15 > 0 ? (int)Math.Round(c * 100.0 / max15) : 0;
                                        <span class="spark-bar @(c == 0 ? "spark-bar--empty" : "")"
                                              style="height:@(c == 0 ? 12 : Math.Max(pct, 25))%"></span>
                                    }
                                </div>
                                <div class="sparkline-caption">últimos 15 días</div>
                            </div>
                        }

                        <div class="student-card__actions">
                            <a href="/Students/Edit/@s.Id" class="btn-secondary btn-sm">Editar</a>
                            <a href="/Classroom/@s.Id" class="btn-main btn-sm">Abrir aula</a>
                        </div>

                        @if (Model.InboxEnabled)
                        {
                            <div style="margin-top:.5rem;border-top:1px dashed #eee;padding-top:.5rem;">
                                @if (string.IsNullOrEmpty(s.ShareToken))
                                {
                                    <form method="post" asp-page-handler="ShareCalendar" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="studentId" value="@s.Id" />
                                        <button type="submit" class="btn-secondary btn-sm"
                                                title="Genera un link público y anónimo del calendario para compartir al grupo del grado">
                                            🔗 Compartir calendario
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    var shareUrl = $"{Model.BaseUrl}/agenda/{s.ShareToken}";
                                    <div style="font-size:.78rem;color:#666;">
                                        <div style="display:flex;gap:.4rem;align-items:center;">
                                            <input type="text" readonly value="@shareUrl" onclick="this.select()"
                                                   style="flex:1;font-size:.72rem;padding:.3rem;border:1px solid #ddd;border-radius:4px;" />
                                            <button type="button" class="btn-secondary btn-sm"
                                                    onclick="navigator.clipboard.writeText('@shareUrl');this.textContent='✓';">Copiar</button>
                                        </div>
                                        <span style="color:#999;">Anónimo — sin el nombre del hijo.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    @* ── Actividad del mes ── *@
    @if (Model.StudentSummaries.Any(s => s.ExchangesThisMonth > 0))
    {
        <section class="dashboard-section">
            <div class="section-header">
                <h2>Actividad del mes</h2>
                <span class="section-meta">intercambios por día</span>
            </div>

            <div class="usage-summary">
                <div class="usage-card">
                    <span class="usage-card__label">Intercambios totales</span>
                    <span class="usage-card__value">@Model.TotalExchangesMonth.ToString("N0")</span>
                </div>
                <div class="usage-card">
                    <span class="usage-card__label">Días activos este mes</span>
                    <span class="usage-card__value">@Model.ActiveDaysThisMonth</span>
                    <span class="usage-card__sub">de @Model.DaysInMonth días</span>
                </div>
                <div class="usage-card">
                    <span class="usage-card__label">Materiales cargados</span>
                    <span class="usage-card__value">@Model.MaterialsCount</span>
                    <span class="usage-card__sub">@(Model.MaterialsCount == 1 ? "materia con material" : "materias con material")</span>
                </div>
            </div>

            <div class="chart-container">
                <canvas id="usageChart"></canvas>
            </div>
        </section>
    }
    else
    {
        <section class="dashboard-section">
            <p class="empty-state">
                Cuando @(Model.Students.Count == 1 ? "tu hijo" : "tus hijos") empiecen a usar el aula, acá vas a ver cuánto estudiaron cada día.
            </p>
        </section>
    }

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@if (Model.StudentSummaries.Any(s => s.ExchangesThisMonth > 0))
{
    <script>
    new Chart(document.getElementById('usageChart'), {
        type: 'bar',
        data: @Html.Raw(Model.ChartJson),
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y} intercambio${ctx.parsed.y !== 1 ? 's' : ''}`
                    }
                }
            },
            scales: {
                x: { stacked: false, grid: { display: false } },
                y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'intercambios' } }
            }
        }
    });
    </script>
}
