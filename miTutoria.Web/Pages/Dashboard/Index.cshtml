@page "/Dashboard"
@model miTutoria.Web.Pages.Dashboard.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<main class="page-main">
    <div class="dashboard-header">
        <h1>Hola, @Model.FamilyName</h1>
        <div class="dashboard-nav-links">
            <a href="/Profile">Editar perfil</a>
        </div>
    </div>

    <section>
        <div class="section-header">
            <h2>Hijos</h2>
            <a href="/Students/Add" class="btn-main" style="padding: 0.6rem 1.4rem; font-size: 0.85rem;">+ Agregar hijo</a>
        </div>

        @if (Model.Students.Count == 0)
        {
            <p class="empty-state">Todavía no hay estudiantes en tu familia.</p>
        }
        else
        {
            <ul class="students-list">
                @foreach (var student in Model.Students)
                {
                    <li>
                        <strong>@student.FullName</strong>
                        <span>@student.Email</span>
                    </li>
                }
            </ul>
        }
    </section>
</main>
