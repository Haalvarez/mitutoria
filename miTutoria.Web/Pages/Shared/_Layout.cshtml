@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400;1,700&family=Instrument+Sans:wght@300;400;500&family=Libre+Baskerville:ital@1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
</head>
<body class="@(ViewData["BodyClass"])">
    <div id="cursor" class="cursor"></div>
    <div id="cursorRing" class="cursor-ring"></div>

    <nav>
        <div class="logo">mi<b>Tutor</b><i>IA</i></div>
        <div class="nav-right">
            <a href="/Entrar" class="nav-btn-student">Soy estudiante</a>
            <a href="/Login" class="nav-btn-family">Acceso familiar</a>
            <a href="#probalo" class="nav-btn-live">Probarlo en vivo</a>
            <span class="nav-tag">Próximamente</span>
        </div>
    </nav>

    @RenderBody()

    @if (ViewData["BodyClass"]?.ToString() != "classroom-page")
    {
        <footer>
            <div class="footer-logo">mi<b>Tutor</b><i>IA</i></div>
            <span>mitutoria.app · Hecho en Argentina 🧉</span>
        </footer>
    }

    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
