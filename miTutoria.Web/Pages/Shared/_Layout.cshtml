@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/jpeg" href="/img/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400;1,700&family=Instrument+Sans:wght@300;400;500&family=Libre+Baskerville:ital@1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(ViewData["BodyClass"])">
    <div id="cursor" class="cursor"></div>
    <div id="cursorRing" class="cursor-ring"></div>

    @if (ViewData["BodyClass"]?.ToString() == "classroom-page")
    {
        var studentName = ViewData["ClassroomStudentName"]?.ToString() ?? "";
        var streak      = ViewData["ClassroomStreak"] is int s ? s : 0;
        var streakMsg   = streak switch {
            0          => "¡Hoy puede ser el día uno! 🌱",
            1          => "¡Primer día de racha, arrancaste! 🔥",
            >= 2 and < 7  => $"🔥 {streak} días seguidos — ¡no pares!",
            >= 7 and < 14 => $"🔥 {streak} días — ¡una semana entera, increíble!",
            _             => $"🔥 {streak} días — ¡sos imparable!"
        };
        var tutorName   = ViewData["ClassroomTutorName"]?.ToString();
        var tutorAvatar = ViewData["ClassroomTutorAvatar"]?.ToString();
        <nav class="classroom-nav">
            <a href="/Dashboard" class="classroom-nav__logo"><img src="/img/logo-wordmark.png" alt="miTutorIA" class="nav-logo-img" /></a>
            @if (!string.IsNullOrEmpty(tutorName) || !string.IsNullOrEmpty(tutorAvatar))
            {
                <span class="classroom-nav__tutor" style="display:inline-flex;align-items:center;gap:.35rem;font-size:.9rem;opacity:.85;">
                    @if (!string.IsNullOrEmpty(tutorAvatar)) { <span style="font-size:1.2rem;">@tutorAvatar</span> }
                    @if (!string.IsNullOrEmpty(tutorName)) { <span>@tutorName</span> }
                </span>
            }
            <span class="classroom-nav__student">@studentName</span>
            <span class="classroom-nav__streak">@streakMsg</span>
        </nav>
    }
    else if (Context.Session.GetInt32("FamilyId").HasValue)
    {
        <nav>
            <a href="/Dashboard"><img src="/img/logo-wordmark.png" alt="miTutorIA" class="nav-logo-img" /></a>
            <div class="nav-right">
                <a href="/Dashboard" class="nav-btn-family">Inicio</a>
                <a href="/Entrar" class="nav-btn-student">Soy estudiante</a>
                <a href="/Salir" class="nav-btn-student">Salir</a>
            </div>
        </nav>
    }
    else
    {
        <nav>
            <a href="/"><img src="/img/logo-wordmark.png" alt="miTutorIA" class="nav-logo-img" /></a>
            <div class="nav-right">
                <a href="/Entrar" class="nav-btn-student">Soy estudiante</a>
                <a href="/Login" class="nav-btn-family">Acceso familiar</a>
                <a href="/#probalo" class="nav-btn-family nav-hide-mobile">Probarlo en vivo</a>
                <a href="/#acceso" class="nav-btn-live nav-hide-mobile">Acceso anticipado</a>
            </div>
        </nav>
    }

    @RenderBody()

    @if (ViewData["BodyClass"]?.ToString() != "classroom-page")
    {
        <footer>
            <img src="/img/logo-wordmark.png" alt="miTutorIA" class="nav-logo-img" style="height:24px;" />
            <span>mitutoria.app · Hecho en Argentina 🧉</span>
        </footer>
    }

    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
